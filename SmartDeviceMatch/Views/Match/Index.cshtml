@model IEnumerable<SmartDeviceMatch.ViewModels.MatchViewModel>

@{
    ViewData["Title"] = "Matched Repair Shops";
}

<div class="d-flex flex-column gap-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-cpu text-primary me-1"></i> Matched Repair Centers
            </h2>
            <p class="text-muted mb-0">
                Verified repair centers ranked by compatibility score (category, brand, proximity, skills, rating).
            </p>
        </div>

        <span class="badge rounded-pill px-3 py-2 bg-white text-secondary border shadow-sm">
            <strong>@Model.Count()</strong> suitable match(es)
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 20px; border: 1px dashed var(--sdm-border) !important;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width: 72px; height: 72px; background: #FEF3C7; color: #D97706; font-size: 30px;">
                <i class="bi bi-geo-alt"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No suitable repair shops found</h4>
            <p class="text-muted mx-auto mb-0" style="max-width: 440px;">
                No verified technician in your region currently satisfies the minimum compatibility threshold score of 60.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var match in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm sdm-card-hover p-4 d-flex flex-column justify-content-between"
                         style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

                        <div>
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="fw-bold text-dark mb-0">@match.ShopName</h5>
                                    <span class="small text-muted"><i class="bi bi-geo-alt"></i> @match.City, @match.State</span>
                                </div>

                                <span class="badge rounded-pill px-3 py-1 fs-6" style="background: #E8F8F0; color: #10B981; font-weight: 700;">
                                    @match.CompatibilityScore% Match
                                </span>
                            </div>

                            <!-- Highlights -->
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom mt-2">
                                <span class="text-muted small">Distance</span>
                                <strong class="small text-dark">@match.DistanceKm.ToString("0.1") km</strong>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <span class="text-muted small">Rating</span>
                                <span class="small fw-bold text-warning">★ @match.Rating.ToString("0.0") / 5</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom mb-3">
                                <span class="text-muted small">Experience</span>
                                <span class="small text-dark fw-semibold">@match.YearsOfExperience yrs</span>
                            </div>

                            <!-- Score Breakdown -->
                            <h6 class="fw-bold text-dark small mb-2">Match Diagnostics</h6>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Category Specialization</span>
                                    <strong class="text-dark">@match.CategoryScore / 30</strong>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 10px;">
                                    <div class="progress-bar" style="width: @((match.CategoryScore / 30.0) * 100)%; background-color: var(--sdm-primary);"></div>
                                </div>
                            </div>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Brand Knowledge</span>
                                    <strong class="text-dark">@match.BrandScore / 25</strong>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 10px;">
                                    <div class="progress-bar" style="width: @((match.BrandScore / 25.0) * 100)%; background-color: var(--sdm-primary);"></div>
                                </div>
                            </div>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Proximity / Distance</span>
                                    <strong class="text-dark">@match.ProximityScore / 20</strong>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 10px;">
                                    <div class="progress-bar" style="width: @((match.ProximityScore / 20.0) * 100)%; background-color: #2563EB;"></div>
                                </div>
                            </div>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Shop Expertise</span>
                                    <strong class="text-dark">@match.ExpertiseScore / 15</strong>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 10px;">
                                    <div class="progress-bar" style="width: @((match.ExpertiseScore / 15.0) * 100)%; background-color: #10B981;"></div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Customer Satisfaction</span>
                                    <strong class="text-dark">@match.RatingScore / 10</strong>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 10px;">
                                    <div class="progress-bar" style="width: @((match.RatingScore / 10.0) * 100)%; background-color: #F59E0B;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="pt-3 border-top">
                            <a asp-controller="Device" asp-action="Details" asp-route-id="@match.DeviceId"
                               class="btn btn-outline-secondary rounded-pill w-100 btn-sm">
                                View Device Details
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>