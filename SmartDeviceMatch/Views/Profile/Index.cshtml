@model SmartDeviceMatch.Models.AppUser

@{
    ViewData["Title"] = "My Profile";

    double averageRating = ViewBag.AverageRating ?? 0;
    int reviewCount = ViewBag.ReviewCount ?? 0;
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <!-- ================================= -->
            <!-- PROFILE CARD -->
            <!-- ================================= -->

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <!-- ================================= -->
                    <!-- PROFILE HEADER -->
                    <!-- ================================= -->

                    <div class="text-center mb-4">

                        <h2 class="mb-2">
                            @Model.FullName
                        </h2>

                        <span class="badge bg-primary">
                            @Model.UserType
                        </span>

                    </div>


                    <!-- ================================= -->
                    <!-- RATING CARD -->
                    <!-- ================================= -->

                    <div class="card bg-light border-0 mb-4">

                        <div class="card-body text-center">

                            <h5 class="text-muted mb-3">
                                Overall Rating
                            </h5>


                            @if (reviewCount > 0)
                            {
                                <!-- Average Number -->

                                <div class="display-5 fw-bold">

                                    @averageRating.ToString("0.0")

                                    <span class="text-muted fs-5">
                                        / 5
                                    </span>

                                </div>


                                <!-- Stars -->

                                <div class="fs-3 mb-2">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(averageRating))
                                        {
                                            <span>⭐</span>
                                        }
                                        else
                                        {
                                            <span>☆</span>
                                        }
                                    }

                                </div>


                                <!-- Review Count -->

                                <p class="text-muted mb-3">

                                    Based on

                                    <strong>
                                        @reviewCount
                                    </strong>

                                    review@(reviewCount == 1 ? "" : "s")

                                </p>
                            }
                            else
                            {
                                <div class="display-6 text-muted">
                                    No Rating
                                </div>

                                <p class="text-muted mb-3">
                                    You have not received any reviews yet.
                                </p>
                            }


                            <!-- View Reviews -->

                            <a asp-controller="Offer"
                               asp-action="MyReviews"
                               class="btn btn-outline-primary">

                                View My Reviews

                            </a>

                        </div>

                    </div>


                    <!-- ================================= -->
                    <!-- PROFILE INFORMATION -->
                    <!-- ================================= -->

                    <h5 class="mb-3">
                        Profile Information
                    </h5>


                    <!-- Full Name -->

                    <div class="mb-3">

                        <label class="text-muted">
                            Full Name
                        </label>

                        <div class="fw-semibold">
                            @Model.FullName
                        </div>

                    </div>


                    <!-- User Type -->

                    <div class="mb-3">

                        <label class="text-muted">
                            Role
                        </label>

                        <div class="fw-semibold">
                            @Model.UserType
                        </div>

                    </div>


                    <!-- City + State -->

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="text-muted">
                                City
                            </label>

                            <div class="fw-semibold">
                                @(Model.City ?? "Not Provided")
                            </div>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="text-muted">
                                State
                            </label>

                            <div class="fw-semibold">
                                @(Model.State ?? "Not Provided")
                            </div>

                        </div>

                    </div>


                    <!-- Pin Code -->

                    <div class="mb-3">

                        <label class="text-muted">
                            Pin Code
                        </label>

                        <div class="fw-semibold">
                            @(Model.PinCode ?? "Not Provided")
                        </div>

                    </div>


                    <!-- ================================= -->
                    <!-- ACTIONS -->
                    <!-- ================================= -->

                    <div class="d-flex gap-2 mt-4">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            Back to Home

                        </a>

                        <a asp-controller="Offer"
                           asp-action="MyReviews"
                           class="btn btn-primary">

                            View Reviews

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>