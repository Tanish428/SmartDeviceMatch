@model SmartDeviceMatch.Models.AppUser

@{
    ViewData["Title"] = "My Profile";

    double averageRating = ViewBag.AverageRating ?? 0;
    int reviewCount = ViewBag.ReviewCount ?? 0;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">

        <!-- Profile Card -->
        <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

            <!-- Header Backdrop -->
            <div class="p-4 text-center position-relative" style="background: linear-gradient(135deg, #FFF6F2 0%, #FAEDE4 100%); border-bottom: 1px solid #F3E4DA;">
                <div class="rounded-circle text-white fw-bold d-inline-flex align-items-center justify-content-center mb-2 shadow"
                     style="width: 80px; height: 80px; background-color: #9B3224; font-size: 28px; border: 3px solid #FFFFFF;">
                    @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName[0].ToString().ToUpper())
                </div>

                <h3 class="fw-bold text-dark mb-1">@Model.FullName</h3>
                <span class="badge rounded-pill px-3 py-1" style="background: var(--sdm-primary-light); color: var(--sdm-primary); font-weight: 600;">
                    @Model.UserType
                </span>
            </div>

            <div class="card-body p-4 p-md-5">

                <!-- Overall Rating Banner -->
                <div class="p-4 rounded-3 text-center mb-4" style="background: #FFFDF5; border: 1px solid #FEF3C7;">
                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Platform Reputation</span>

                    @if (reviewCount > 0)
                    {
                        <div class="display-6 fw-bold text-dark mb-1">
                            @averageRating.ToString("0.0") <span class="text-muted fs-6">/ 5.0</span>
                        </div>

                        <div class="fs-5 mb-1" style="color: #F59E0B;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(averageRating))
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }
                        </div>

                        <span class="text-muted small">Based on <strong>@reviewCount</strong> verified review(s)</span>
                    }
                    else
                    {
                        <div class="text-muted py-2">
                            <i class="bi bi-star fs-3 d-block text-secondary opacity-50 mb-1"></i>
                            <span>No ratings or reviews received yet.</span>
                        </div>
                    }
                </div>

                <!-- Profile Information Details -->
                <h6 class="fw-bold text-dark mb-3">Account Information</h6>

                <div class="d-flex flex-column gap-2 mb-4">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Account Type</span>
                        <strong class="text-dark">@Model.UserType</strong>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">City</span>
                        <span class="fw-semibold text-dark">@(Model.City ?? "Not Provided")</span>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">State</span>
                        <span class="fw-semibold text-dark">@(Model.State ?? "Not Provided")</span>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">PIN Code</span>
                        <span class="fw-semibold text-dark">@(Model.PinCode ?? "Not Provided")</span>
                    </div>

                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Member Since</span>
                        <span class="text-muted">@Model.CreatedAt.ToString("MMM yyyy")</span>
                    </div>
                </div>

                <!-- Navigation Actions -->
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Back to Home
                    </a>
                    <a asp-controller="Offer" asp-action="MyReviews" class="btn btn-terracotta rounded-pill px-4">
                        <i class="bi bi-star me-1"></i> View Reviews
                    </a>
                </div>

            </div>

        </div>

    </div>
</div>