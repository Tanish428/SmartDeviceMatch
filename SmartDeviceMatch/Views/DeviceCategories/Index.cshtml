@model IEnumerable<SmartDeviceMatch.Models.DeviceCategory>

@{
    ViewData["Title"] = "Device Categories";
}

<div class="container mt-4">
    <h2>Device Categories</h2>

   
    <a href="/DeviceCategories/Create" class="btn btn-primary mb-3">Add New Category</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Category Name</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
           
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>