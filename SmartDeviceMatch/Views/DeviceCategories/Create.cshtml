@model SmartDeviceMatch.Models.DeviceCategory

@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

            <div class="p-4 p-md-5" style="background: linear-gradient(135deg, #FFF8F4 0%, #FAEDE4 100%); border-bottom: 1px solid #F3E4DA;">
                <span class="badge rounded-pill px-3 py-1 mb-2" style="background: var(--sdm-primary-light); color: var(--sdm-primary); font-weight: 600;">
                    Taxonomy
                </span>
                <h3 class="fw-bold text-dark mb-1">Create New Category</h3>
                <p class="text-muted small mb-0">Add a hardware classification for device listings.</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold text-dark">Category Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Smartwatches, Tablets, Drones" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold text-dark">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Describe devices included under this category..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-terracotta rounded-pill px-5">
                            Save Category
                        </button>
                    </div>

                </form>
            </div>

        </div>

    </div>
</div>