@model IEnumerable<SmartDeviceMatch.Models.Device>

@{
    ViewData["Title"] = "Refurbished Devices Marketplace";
}

<div class="d-flex flex-column gap-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Refurbished Devices Marketplace</h2>
            <p class="text-muted mb-0">
                Browse tested, restored, and warranty-backed refurbished electronics ready for daily use.
            </p>
        </div>

        <span class="badge rounded-pill px-3 py-2 bg-white text-secondary border shadow-sm">
            <i class="bi bi-patch-check text-success me-1"></i> <strong>@Model.Count()</strong> device(s) ready
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 20px; border: 1px dashed var(--sdm-border) !important;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width: 72px; height: 72px; background: #DCFCE7; color: #16A34A; font-size: 30px;">
                <i class="bi bi-box-seam"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No refurbished devices currently available</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 440px;">
                Repaired and certified devices will appear here once verified technicians complete refurbishing.
            </p>
            <div>
                <a asp-action="BrokenDevices" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                    Browse Repairable Devices Instead
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var device in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm sdm-card-hover overflow-hidden"
                         style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

                        <!-- Device Photo -->
                        <div class="position-relative" style="height: 200px; background: #F8F6F2;">
                            @if (device.Images != null && device.Images.Any())
                            {
                                var primaryImage = device.Images.OrderBy(i => i.DisplayOrder).First();
                                <img src="@primaryImage.ImageUrl" alt="@device.BrandName @device.ModelName"
                                     class="w-100 h-100" style="object-fit: cover;" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                                    <i class="bi bi-laptop fs-1 opacity-50 mb-1"></i>
                                    <span class="small">No Photo Available</span>
                                </div>
                            }

                            <!-- Badges -->
                            <div class="position-absolute top-0 start-0 m-3 d-flex gap-1">
                                <span class="badge rounded-pill px-3 py-1 shadow-sm" style="background: #E8F8F0; color: #10B981; font-weight: 700;">
                                    <i class="bi bi-patch-check-fill me-1"></i> Refurbished
                                </span>
                                <span class="badge rounded-pill bg-light text-dark border shadow-sm">
                                    Grade @device.ConditionGrade
                                </span>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge rounded-pill px-2 py-1 bg-light text-secondary border small mb-2">
                                    @(device.Category?.Name ?? "Refurbished")
                                </span>

                                <h5 class="fw-bold text-dark mb-1 text-truncate">
                                    @device.BrandName @device.ModelName
                                </h5>

                                <div class="d-flex justify-content-between align-items-center my-3">
                                    <div>
                                        <small class="text-muted d-block">Price</small>
                                        <span class="fs-5 fw-bold text-dark" style="color: var(--sdm-primary) !important;">
                                            ₹@device.AskingPrice.ToString("N2")
                                        </span>
                                    </div>
                                    @if (device.EstimatedValue.HasValue)
                                    {
                                        <div class="text-end">
                                            <small class="text-muted d-block">Est. Value</small>
                                            <span class="small fw-semibold text-secondary">
                                                ₹@device.EstimatedValue.Value.ToString("N2")
                                            </span>
                                        </div>
                                    }
                                </div>

                                <p class="small text-muted mb-3">
                                    <i class="bi bi-geo-alt me-1"></i> @(device.City ?? "Local"), @(device.State ?? "")
                                </p>
                            </div>

                            <!-- Buyer CTA buttons -->
                            <div class="d-grid gap-2 pt-2 border-top">
                                <a asp-controller="Marketplace" asp-action="Details" asp-route-id="@device.Id" class="btn btn-outline-secondary rounded-pill btn-sm">
                                    View Details
                                </a>

                                @if (User.IsInRole("Buyer"))
                                {
                                    <a asp-controller="Offer" asp-action="CreatePurchase" asp-route-deviceId="@device.Id" class="btn btn-terracotta rounded-pill btn-sm">
                                        <i class="bi bi-bag-check me-1"></i> Make Purchase Offer
                                    </a>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>