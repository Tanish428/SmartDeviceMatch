@model SmartDeviceMatch.Models.Offer

@{
    ViewData["Title"] = "Make Repair Offer";
    var device = ViewBag.Device as SmartDeviceMatch.Models.Device;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">

        <div class="mb-3">
            <a asp-controller="Marketplace" asp-action="BrokenDevices" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1">
                <i class="bi bi-arrow-left me-1"></i> Back to Broken Devices
            </a>
        </div>

        <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

            <!-- Header -->
            <div class="p-4 p-md-5" style="background: linear-gradient(135deg, #FFF8F4 0%, #FAEDE4 100%); border-bottom: 1px solid #F3E4DA;">
                <span class="badge rounded-pill px-3 py-1 mb-2" style="background: var(--sdm-primary-light); color: var(--sdm-primary); font-weight: 600;">
                    Repair Quotation
                </span>
                <h3 class="fw-bold text-dark mb-1">Make a Repair Offer</h3>
                <p class="text-muted small mb-0">Submit an estimated cost proposal to the device owner.</p>
            </div>

            <div class="card-body p-4 p-md-5">

                @if (device != null)
                {
                    <!-- Device Summary -->
                    <div class="p-4 rounded-3 mb-4" style="background: #F9F8F5; border: 1px solid #ECE7DE;">
                        <span class="badge rounded-pill px-2 py-1 bg-light text-secondary border small mb-1">
                            @(device.Category?.Name ?? "Device")
                        </span>
                        <h5 class="fw-bold text-dark mb-2">@device.BrandName @device.ModelName</h5>

                        <div class="row g-2 small text-secondary">
                            <div class="col-sm-6">
                                <strong>Condition:</strong> Grade @device.ConditionGrade
                            </div>
                            <div class="col-sm-6">
                                <strong>Damage Issue:</strong> <span class="text-danger fw-semibold">@device.DamageType</span>
                            </div>
                            <div class="col-12">
                                <strong>Location:</strong> @device.City, @device.State
                            </div>
                        </div>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="deviceId" value="@device?.Id" />

                    <!-- Offer Amount -->
                    <div class="mb-4">
                        <label for="offerAmount" class="form-label fw-semibold text-dark">Quoted Repair Cost</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 fw-bold">₹</span>
                            <input type="number" id="offerAmount" name="offerAmount" class="form-control border-start-0 ps-0"
                                   min="1" step="0.01" placeholder="0.00" required />
                        </div>
                        <div class="form-text small text-muted">Enter the total service and parts cost you are proposing to repair this device.</div>
                        <span class="text-danger small" asp-validation-for="OfferAmount"></span>
                    </div>

                    <!-- Message -->
                    <div class="mb-4">
                        <label for="message" class="form-label fw-semibold text-dark">Technician's Note / Scope of Repair</label>
                        <textarea id="message" name="message" class="form-control" rows="4" maxlength="1000"
                                  placeholder="Describe the estimated repair procedure, turnaround days, warranty on parts, etc..."></textarea>
                        <div class="form-text small text-muted">Optional &bull; Maximum 1,000 characters.</div>
                    </div>

                    <!-- Policy note -->
                    <div class="p-3 rounded-3 small mb-4" style="background: #EFF6FF; border: 1px solid #DBEAFE; color: #1E40AF;">
                        <i class="bi bi-info-circle me-1"></i>
                        The owner will receive an instant notification and can review, accept, or chat regarding your quote. Offers remain open for 7 days.
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2">
                        <a asp-controller="Marketplace" asp-action="BrokenDevices" class="btn btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-terracotta rounded-pill px-5">
                            Submit Repair Quote
                        </button>
                    </div>
                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}