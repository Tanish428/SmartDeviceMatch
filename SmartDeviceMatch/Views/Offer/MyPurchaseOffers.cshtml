@model IEnumerable<SmartDeviceMatch.Models.Offer>

@{
    ViewData["Title"] = "My Purchase Offers";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">

        <h2>My Purchase Offers</h2>

        <p class="text-muted">
            View the purchase offers you have submitted.
        </p>

    </div>


    @if (TempData["PurchaseMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["PurchaseMessage"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="card shadow-sm text-center p-5">

            <h4>No purchase offers yet.</h4>

            <p class="text-muted">
                Your submitted purchase offers will appear here.
            </p>

            <a asp-controller="Marketplace"
               asp-action="Refurbished"
               class="btn btn-primary">

                Browse Refurbished Devices

            </a>

        </div>
    }
    else
    {
        <div class="mb-3">

            <strong>@Model.Count()</strong>
            purchase offer(s)

        </div>


        <div class="row g-4">

            @foreach (var offer in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            @if (offer.Device != null)
                            {
                                <h5 class="card-title">

                                    @offer.Device.BrandName
                                    @offer.Device.ModelName

                                </h5>

                                <p class="text-muted">
                                    @offer.Device.Category?.Name
                                </p>
                            }

                            <hr />

                            @if (offer.RepairShop != null)
                            {
                                <div class="mb-2">

                                    <span class="text-muted">
                                        Seller:
                                    </span>

                                    <strong>
                                        @offer.RepairShop.ShopName
                                    </strong>

                                </div>
                            }


                            <div class="mb-2">

                                <span class="text-muted">
                                    Your Offer:
                                </span>

                                <strong>
                                    ₹@offer.OfferAmount.ToString("0.00")
                                </strong>

                            </div>


                            <div class="mb-2">

                                <span class="text-muted">
                                    Status:
                                </span>

                                @if (offer.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (offer.Status == "Accepted")
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else if (offer.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else if (offer.Status == "Expired")
                                {
                                    <span class="badge bg-secondary">
                                        Expired
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @offer.Status
                                    </span>
                                }

                            </div>


                            <div class="mb-3">

                                <span class="text-muted">
                                    Expires:
                                </span>

                                @offer.ExpiresAt.ToShortDateString()

                            </div>


                            @if (!string.IsNullOrWhiteSpace(offer.Message))
                            {
                                <div>

                                    <strong>
                                        Your Message:
                                    </strong>

                                    <p class="text-muted mb-0">
                                        @offer.Message
                                    </p>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>