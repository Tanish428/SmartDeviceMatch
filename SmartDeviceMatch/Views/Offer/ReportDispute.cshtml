@{
    ViewData["Title"] = "Report a Dispute";
}

<div class="container mt-5" style="max-width: 650px;">

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <h3 class="mb-2">Report a Dispute</h3>

            <p class="text-muted">
                Submit an issue related to this offer.
                The Admin will review your report.
            </p>

            <hr />

            <div class="mb-3">
                <strong>Offer ID:</strong>
                #@ViewBag.OfferId
            </div>

            <div class="mb-3">
                <strong>Device:</strong>
                @ViewBag.DeviceName
            </div>

            <form asp-controller="Offer"
                  asp-action="ReportDispute"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="offerId"
                       value="@ViewBag.OfferId" />

                <div class="mb-3">

                    <label for="reason"
                           class="form-label">
                        Explain your issue
                    </label>

                    <textarea name="reason"
                              id="reason"
                              class="form-control"
                              rows="5"
                              maxlength="1000"
                              required
                              placeholder="Describe the problem with this offer or transaction..."></textarea>

                    @Html.ValidationMessage(
                        "reason",
                        "",
                        new { @class = "text-danger" })

                </div>

                <button type="submit"
                        class="btn btn-danger">
                    Submit Dispute
                </button>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>