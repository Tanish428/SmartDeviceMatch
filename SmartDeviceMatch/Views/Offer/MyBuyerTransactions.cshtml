@model IEnumerable<SmartDeviceMatch.Models.Offer>

@{
    ViewData["Title"] = "My Transactions";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h2>My Transactions</h2>
        <p class="text-muted">
            View your accepted purchase transactions.
        </p>
    </div>

    @if (TempData["TransactionMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["TransactionMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm text-center p-5">

            <h4>No transactions yet.</h4>

            <p class="text-muted">
                Your accepted purchase offers will appear here.
            </p>

            <a asp-controller="Marketplace"
               asp-action="Refurbished"
               class="btn btn-primary">
                Browse Refurbished Devices
            </a>

        </div>
    }
    else
    {
        <div class="mb-3">
            <strong>@Model.Count()</strong>
            transaction(s)
        </div>

        <div class="row g-4">

            @foreach (var transaction in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            @if (transaction.Device != null)
                            {
                                <h5 class="card-title">
                                    @transaction.Device.BrandName
                                    @transaction.Device.ModelName
                                </h5>

                                <p class="text-muted">
                                    @transaction.Device.Category?.Name
                                </p>
                            }

                            <hr />

                            @if (transaction.RepairShop != null)
                            {
                                <div class="mb-2">
                                    <span class="text-muted">
                                        Seller:
                                    </span>

                                    <strong>
                                        @transaction.RepairShop.ShopName
                                    </strong>
                                </div>
                            }

                            <div class="mb-2">
                                <span class="text-muted">
                                    Amount:
                                </span>

                                <strong>
                                    ₹@transaction.OfferAmount.ToString("0.00")
                                </strong>
                            </div>

                            <div class="mb-2">
                                <span class="text-muted">
                                    Transaction Status:
                                </span>

                                @if (transaction.Status == "Accepted")
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else if (transaction.Status == "Escrowed")
                                {
                                    <span class="badge bg-primary">
                                        Escrowed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @transaction.Status
                                    </span>
                                }
                            </div>

                            <div class="mb-2">
                                <span class="text-muted">
                                    Offer Type:
                                </span>

                                @transaction.OfferType
                            </div>

                            <div class="mb-3">
                                <span class="text-muted">
                                    Offer Expiry:
                                </span>

                                @transaction.ExpiresAt.ToShortDateString()
                            </div>

                            @if (!string.IsNullOrWhiteSpace(transaction.Message))
                            {
                                <div class="mb-3">
                                    <strong>
                                        Your Message:
                                    </strong>

                                    <p class="text-muted mb-0">
                                        @transaction.Message
                                    </p>
                                </div>
                            }

                            @if (transaction.Status == "Accepted")
                            {
                                <div class="mt-3">

                                    <form asp-controller="Offer"
                                          asp-action="Escrow"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@transaction.Id" />

                                        <button type="submit"
                                                class="btn btn-primary w-100">
                                            Pay &amp; Place in Escrow
                                        </button>

                                    </form>

                                </div>
                            }
                            else if (transaction.Status == "Escrowed")
                            {
                                <div class="alert alert-primary mt-3 mb-0">
                                    <strong>Payment in Escrow</strong>
                                    <br />
                                    <small>
                                        Your payment has been placed in
                                        escrow successfully.
                                    </small>
                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>