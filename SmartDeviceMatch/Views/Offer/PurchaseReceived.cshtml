@model IEnumerable<SmartDeviceMatch.Models.Offer>

@{
    ViewData["Title"] = "Received Purchase Offers";
}

<div class="d-flex flex-column gap-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Received Purchase Offers</h2>
            <p class="text-muted mb-0">
                Buyer purchase offers for your listed refurbished and repaired inventory.
            </p>
        </div>

        <span class="badge rounded-pill px-3 py-2 bg-white text-secondary border shadow-sm">
            <strong>@Model.Count()</strong> offer(s) received
        </span>
    </div>

    @if (TempData["PurchaseMessage"] != null)
    {
        <div class="alert alert-info rounded-3 border-0 shadow-sm">
            <i class="bi bi-info-circle me-1"></i> @TempData["PurchaseMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 20px; border: 1px dashed var(--sdm-border) !important;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width: 72px; height: 72px; background: #EFF6FF; color: #2563EB; font-size: 30px;">
                <i class="bi bi-inbox"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No purchase offers received yet</h4>
            <p class="text-muted mx-auto mb-0" style="max-width: 420px;">
                When prospective buyers submit purchase bids for your refurbished devices, they will appear here.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var offer in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm sdm-card-hover p-4 d-flex flex-column justify-content-between"
                         style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

                        <div>
                            @if (offer.Device != null)
                            {
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge rounded-pill px-2 py-1 bg-light text-secondary border small">
                                        @(offer.Device.Category?.Name ?? "Refurbished")
                                    </span>
                                    @if (offer.Status == "Pending")
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: #FEF3C7; color: #D97706; font-weight: 600;">Pending</span>
                                    }
                                    else if (offer.Status == "Accepted")
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: #DCFCE7; color: #16A34A; font-weight: 600;">Accepted</span>
                                    }
                                    else if (offer.Status == "Rejected")
                                    {
                                        <span class="badge rounded-pill px-3 py-1" style="background: #FEE2E2; color: #DC2626; font-weight: 600;">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary px-3 py-1">@offer.Status</span>
                                    }
                                </div>

                                <h5 class="fw-bold text-dark mb-3">
                                    @offer.Device.BrandName @offer.Device.ModelName
                                </h5>
                            }

                            @if (offer.Buyer != null)
                            {
                                <div class="p-3 rounded-3 mb-3" style="background: #F9F8F5; border: 1px solid #ECE7DE;">
                                    <small class="text-muted d-block">Buyer Profile</small>
                                    <span class="fw-bold text-dark">
                                        <i class="bi bi-person me-1 text-primary"></i> @offer.Buyer.FullName
                                    </span>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <span class="text-muted small">Offer Amount</span>
                                <span class="fs-5 fw-bold" style="color: var(--sdm-primary);">
                                    ₹@offer.OfferAmount.ToString("N2")
                                </span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <span class="text-muted small">Expires On</span>
                                <span class="text-muted small">@offer.ExpiresAt.ToString("MMM dd, yyyy")</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(offer.Message))
                            {
                                <div class="mt-3 p-3 rounded-3 small text-secondary" style="background: #FFFFFF; border: 1px solid #EAE6DF;">
                                    <strong>Buyer's Message:</strong> @offer.Message
                                </div>
                            }
                        </div>

                        <!-- Actions -->
                        @if (offer.Status == "Pending")
                        {
                            <div class="pt-3 mt-3 border-top d-flex gap-2">
                                <form asp-controller="Offer" asp-action="AcceptPurchase" method="post" class="flex-fill">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@offer.Id" />
                                    <button type="submit" class="btn btn-terracotta rounded-pill btn-sm w-100">
                                        Accept Offer
                                    </button>
                                </form>

                                <form asp-controller="Offer" asp-action="RejectPurchase" method="post" class="flex-fill">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@offer.Id" />
                                    <button type="submit" class="btn btn-outline-danger rounded-pill btn-sm w-100">
                                        Reject
                                    </button>
                                </form>
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    }

</div>