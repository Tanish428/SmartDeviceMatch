@model IEnumerable<SmartDeviceMatch.Models.Offer>

@{
    ViewData["Title"] = "My Active Offers";
}

<div class="d-flex flex-column gap-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Active Repair Offers</h2>
            <p class="text-muted mb-0">
                Track and manage the repair proposals you have submitted to device owners.
            </p>
        </div>

        <a asp-controller="Marketplace" asp-action="BrokenDevices" class="btn btn-terracotta rounded-pill px-4">
            <i class="bi bi-search me-1"></i> Browse Broken Devices
        </a>
    </div>

    @if (TempData["DisputeMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
            <i class="bi bi-info-circle me-1"></i> @TempData["DisputeMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 20px; border: 1px dashed var(--sdm-border) !important;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width: 72px; height: 72px; background: #DBEAFE; color: #2563EB; font-size: 30px;">
                <i class="bi bi-tag"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No active repair offers submitted</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 440px;">
                Browse listed devices in need of repair and submit competitive bids to grow your repair shop clientele.
            </p>
            <div>
                <a asp-controller="Marketplace" asp-action="BrokenDevices" class="btn btn-terracotta rounded-pill px-4 py-2">
                    Browse Broken Devices
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var offer in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm sdm-card-hover p-4 d-flex flex-column justify-content-between"
                         style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

                        <div>
                            <!-- Header with Device & Status -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <span class="badge rounded-pill px-2 py-1 bg-light text-secondary border small mb-1">
                                        Device #@offer.DeviceId
                                    </span>
                                    <h5 class="fw-bold text-dark mb-0">
                                        @(offer.Device != null ? $"{offer.Device.BrandName} {offer.Device.ModelName}" : "Target Device")
                                    </h5>
                                </div>

                                @if (offer.Status == "Pending")
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: #FEF3C7; color: #D97706; font-weight: 600;">
                                        Pending
                                    </span>
                                }
                                else if (offer.Status == "Accepted")
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: #DCFCE7; color: #16A34A; font-weight: 600;">
                                        Accepted
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary px-3 py-1">@offer.Status</span>
                                }
                            </div>

                            <!-- Offer Details -->
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <span class="text-muted small">Your Bid Amount</span>
                                <span class="fs-5 fw-bold" style="color: var(--sdm-primary);">
                                    ₹@offer.OfferAmount.ToString("N2")
                                </span>
                            </div>

                            @if (offer.OfferType != null)
                            {
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-muted small">Offer Type</span>
                                    <span class="badge rounded-pill bg-light text-secondary border small">@offer.OfferType</span>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <span class="text-muted small">Offer Expires</span>
                                <span class="text-muted small">@offer.ExpiresAt.ToString("MMM dd, yyyy")</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(offer.Message))
                            {
                                <div class="mt-3 p-3 rounded-3 small text-secondary" style="background: #F9F8F5; border: 1px solid #ECE7DE;">
                                    <strong>Your Message:</strong> @offer.Message
                                </div>
                            }
                        </div>

                        <!-- Actions -->
                        <div class="pt-3 mt-3 border-top d-flex gap-2">
                            <a asp-controller="Marketplace" asp-action="Details" asp-route-id="@offer.DeviceId"
                               class="btn btn-outline-secondary rounded-pill btn-sm flex-fill">
                                View Device
                            </a>

                            @if (offer.Device?.Owner != null)
                            {
                                <a asp-controller="Chat" asp-action="Start" asp-route-offerId="@offer.Id"
                                   class="btn btn-terracotta rounded-pill btn-sm flex-fill">
                                    <i class="bi bi-chat-dots me-1"></i> Chat
                                </a>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>
