@model IEnumerable<SmartDeviceMatch.Models.Offer>

@{
    ViewData["Title"] = "My Offers";
}

<div class="container mt-4 mb-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>My Repair Offers</h2>

            <p class="text-muted mb-0">
                View the repair offers you have submitted.
            </p>
        </div>

        <a asp-controller="Marketplace"
           asp-action="BrokenDevices"
           class="btn btn-primary">
            Browse Broken Devices
        </a>

    </div>


    @if (!Model.Any())
    {
        <!-- No Offers -->

        <div class="card shadow-sm text-center p-5">

            <h4>No repair offers yet.</h4>

            <p class="text-muted">
                Browse broken devices and submit a repair offer
                to get started.
            </p>

            <div>
                <a asp-controller="Marketplace"
                   asp-action="BrokenDevices"
                   class="btn btn-primary">
                    Browse Broken Devices
                </a>
            </div>

        </div>
    }
    else
    {
        <!-- Offer Count -->

        <div class="mb-3">

            <strong>
                @Model.Count()
            </strong>

            repair offer(s)

        </div>


        <!-- Offers -->

        <div class="row g-4">

            @foreach (var offer in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <!-- Device -->

                            <h5 class="card-title">

                                @if (offer.Device != null)
                                {
                                    @offer.Device.BrandName
                                    @offer.Device.ModelName
                                }
                                else
                                {
                                    <span>
                                        Device unavailable
                                    </span>
                                }

                            </h5>


                            <!-- Category -->

                            @if (offer.Device?.Category != null)
                            {
                                <p class="text-muted mb-3">

                                    @offer.Device.Category.Name

                                </p>
                            }


                            <hr />


                            <!-- Offer Amount -->

                            <div class="mb-2">

                                <span class="text-muted">
                                    Repair Offer:
                                </span>

                                <strong>
                                    ₹@offer.OfferAmount.ToString("0.00")
                                </strong>

                            </div>


                            <!-- Offer Status -->

                            <div class="mb-2">

                                <span class="text-muted">
                                    Status:
                                </span>

                                @if (offer.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (offer.Status == "Accepted")
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else if (offer.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @offer.Status
                                    </span>
                                }

                            </div>


                            <!-- Offer Date -->

                            <div class="mb-2">

                                <span class="text-muted">
                                    Expires:
                                </span>

                                @offer.ExpiresAt.ToShortDateString()

                            </div>


                            <!-- Message -->

                            @if (!string.IsNullOrWhiteSpace(offer.Message))
                            {
                                <div class="mt-3">

                                    <span class="text-muted">
                                        Message:
                                    </span>

                                    <p class="mb-0">
                                        @offer.Message
                                    </p>

                                </div>
                            }


                            <!-- Device Location -->

                            @if (offer.Device != null)
                            {
                                <div class="mt-3">

                                    <small class="text-muted">
                                        Device Location:
                                        @offer.Device.City,
                                        @offer.Device.State
                                    </small>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>