@model IEnumerable<SmartDeviceMatch.Models.Offer>

@{
    ViewData["Title"] = "My Seller Transactions";
}

<div class="d-flex flex-column gap-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Sales Transactions</h2>
            <p class="text-muted mb-0">
                Track escrow payments, hardware verification status, and payout releases for refurbished devices.
            </p>
        </div>

        <span class="badge rounded-pill px-3 py-2 bg-white text-secondary border shadow-sm">
            <strong>@Model.Count()</strong> transaction(s)
        </span>
    </div>

    @if (TempData["TransactionMessage"] != null)
    {
        <div class="alert alert-info rounded-3 border-0 shadow-sm">
            <i class="bi bi-info-circle me-1"></i> @TempData["TransactionMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 20px; border: 1px dashed var(--sdm-border) !important;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width: 72px; height: 72px; background: #DCFCE7; color: #16A34A; font-size: 30px;">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No active sales transactions</h4>
            <p class="text-muted mx-auto mb-0" style="max-width: 440px;">
                Accepted purchase offers for your refurbished inventory will appear here with live escrow tracking.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var transaction in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm sdm-card-hover p-4 d-flex flex-column justify-content-between"
                         style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

                        <div>
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge rounded-pill px-2 py-1 bg-light text-secondary border small">
                                    Txn #@transaction.Id
                                </span>

                                @if (transaction.Status == "Accepted")
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: #FEF3C7; color: #D97706; font-weight: 600;">Accepted</span>
                                }
                                else if (transaction.Status == "Escrowed")
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: #EFF6FF; color: #2563EB; font-weight: 600;">In Escrow</span>
                                }
                                else if (transaction.Status == "Verified")
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: #DCFCE7; color: #16A34A; font-weight: 600;">Verified</span>
                                }
                                else if (transaction.Status == "Released")
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: #E0E7FF; color: #4338CA; font-weight: 600;">Released</span>
                                }
                                else if (transaction.Status == "Completed")
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: #DCFCE7; color: #16A34A; font-weight: 600;">Completed</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary px-3 py-1">@transaction.Status</span>
                                }
                            </div>

                            @if (transaction.Device != null)
                            {
                                <h5 class="fw-bold text-dark mb-3">
                                    @transaction.Device.BrandName @transaction.Device.ModelName
                                </h5>
                            }

                            <!-- Financial Box -->
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <span class="text-muted small">Sale Amount</span>
                                <span class="fs-5 fw-bold" style="color: var(--sdm-primary);">
                                    ₹@transaction.OfferAmount.ToString("N2")
                                </span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <span class="text-muted small">Transaction Type</span>
                                <span class="text-secondary small fw-semibold">@transaction.OfferType</span>
                            </div>

                            @if (transaction.EscrowedAt.HasValue)
                            {
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-muted small">Escrow Secured</span>
                                    <span class="small text-muted">@transaction.EscrowedAt.Value.ToLocalTime().ToString("dd MMM, hh:mm tt")</span>
                                </div>
                            }

                            @if (transaction.VerifiedAt.HasValue)
                            {
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-muted small">Device Verified</span>
                                    <span class="small text-muted">@transaction.VerifiedAt.Value.ToLocalTime().ToString("dd MMM, hh:mm tt")</span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(transaction.Message))
                            {
                                <div class="mt-3 p-3 rounded-3 small text-secondary" style="background: #F9F8F5; border: 1px solid #ECE7DE;">
                                    <strong>Buyer Note:</strong> @transaction.Message
                                </div>
                            }
                        </div>

                        <!-- Actions & Status Notifications -->
                        <div class="pt-3 mt-3 border-top d-flex flex-column gap-2">
                            @if (transaction.Status == "Escrowed")
                            {
                                <div class="p-2 rounded-3 text-center small" style="background: #EFF6FF; color: #1E40AF;">
                                    <i class="bi bi-shield-lock me-1"></i> Buyer payment in escrow. Awaiting inspection.
                                </div>
                            }
                            else if (transaction.Status == "Verified")
                            {
                                <div class="p-2 rounded-3 text-center small mb-2" style="background: #DCFCE7; color: #15803D;">
                                    <i class="bi bi-check2-circle me-1"></i> Device verified by buyer!
                                </div>

                                <form asp-controller="Offer" asp-action="ReleasePayment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@transaction.Id" />
                                    <button type="submit" class="btn btn-terracotta rounded-pill w-100 btn-sm">
                                        <i class="bi bi-cash-stack me-1"></i> Release Payment
                                    </button>
                                </form>
                            }
                            else if (transaction.Status == "Released")
                            {
                                <div class="p-2 rounded-3 text-center small mb-2" style="background: #E0E7FF; color: #3730A3;">
                                    <i class="bi bi-wallet2 me-1"></i> Payout released to your account.
                                </div>

                                <form asp-controller="Offer" asp-action="CompleteTransaction" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@transaction.Id" />
                                    <button type="submit" class="btn btn-success rounded-pill w-100 btn-sm">
                                        <i class="bi bi-check-lg me-1"></i> Finalize Transaction
                                    </button>
                                </form>
                            }
                            else if (transaction.Status == "Completed")
                            {
                                <div class="p-2 rounded-3 text-center small" style="background: #DCFCE7; color: #15803D;">
                                    <i class="bi bi-patch-check-fill me-1"></i> Transaction Successfully Completed
                                </div>

                                <a asp-controller="Offer" asp-action="CreateReview" asp-route-offerId="@transaction.Id"
                                   class="btn btn-outline-secondary rounded-pill btn-sm w-100">
                                    <i class="bi bi-star me-1"></i> Write Review
                                </a>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>