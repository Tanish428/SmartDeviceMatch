@model IEnumerable<SmartDeviceMatch.Models.Review>

@{
    ViewData["Title"] = "My Reviews";

    double averageRating = ViewBag.AverageRating ?? 0;
    int reviewCount = ViewBag.ReviewCount ?? 0;
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>My Reviews</h2>

            <p class="text-muted mb-0">
                Reviews received from other users.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Back

        </a>

    </div>


    <!-- ========================= -->
    <!-- AVERAGE RATING -->
    <!-- ========================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-body text-center p-4">

            <h5 class="text-muted">
                Overall Rating
            </h5>

            @if (reviewCount > 0)
            {
                <div class="display-5 fw-bold">

                    @averageRating.ToString("0.0")

                    <span class="text-muted fs-5">
                        / 5
                    </span>

                </div>


                <div class="fs-4 mb-2">

                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(averageRating))
                        {
                            <span>⭐</span>
                        }
                        else
                        {
                            <span>☆</span>
                        }
                    }

                </div>


                <p class="text-muted mb-0">

                    Based on
                    <strong>@reviewCount</strong>
                    review@(reviewCount == 1 ? "" : "s")

                </p>
            }
            else
            {
                <div class="display-6 text-muted">
                    No Rating
                </div>

                <p class="text-muted mb-0">
                    You have not received any reviews yet.
                </p>
            }

        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center p-5">

                <h5>No Reviews Yet</h5>

                <p class="text-muted mb-0">
                    You have not received any reviews yet.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row">

            @foreach (var review in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <!-- ========================= -->
                            <!-- RATING -->
                            <!-- ========================= -->

                            <div class="mb-2">

                                <span class="fs-5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <span>⭐</span>
                                        }
                                        else
                                        {
                                            <span>☆</span>
                                        }
                                    }
                                </span>

                                <span class="text-muted ms-2">
                                    @review.Rating / 5
                                </span>

                            </div>


                            <!-- ========================= -->
                            <!-- REVIEWER -->
                            <!-- ========================= -->

                            <div class="mb-3">

                                @if (review.IsAnonymous)
                                {
                                    <strong>
                                        Anonymous User
                                    </strong>
                                }
                                else
                                {
                                    <strong>
                                        @review.Reviewer?.FullName
                                    </strong>
                                }

                                <br />

                                <small class="text-muted">
                                    Reviewed on
                                    @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </small>

                            </div>


                            <!-- ========================= -->
                            <!-- COMMENT -->
                            <!-- ========================= -->
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <div class="border rounded p-3 bg-light">

                                    <p class="mb-0">
                                        @review.Comment
                                    </p>

                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">
                                    No written comment.
                                </p>
                            }


                            <!-- ========================= -->
                            <!-- DEVICE -->
                            <!-- ========================= -->
                            @if (review.Offer?.Device != null)
                            {
                                <div class="mt-3">

                                    <small class="text-muted">
                                        Transaction for:
                                    </small>

                                    <br />

                                    <strong>
                                        @review.Offer.Device.BrandName
                                        @review.Offer.Device.ModelName
                                    </strong>

                                    @if (review.Offer.Device.Category != null)
                                    {
                                        <small class="text-muted">
                                            -
                                            @review.Offer.Device.Category.Name
                                        </small>
                                    }

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>