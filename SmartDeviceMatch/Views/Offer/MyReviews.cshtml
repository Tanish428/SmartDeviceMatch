@model IEnumerable<SmartDeviceMatch.Models.Review>

@{
    ViewData["Title"] = "My Reviews";

    double averageRating = ViewBag.AverageRating ?? 0;
    int reviewCount = ViewBag.ReviewCount ?? 0;
}

<div class="d-flex flex-column gap-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Reviews & Ratings</h2>
            <p class="text-muted mb-0">
                Verified feedback from marketplace buyers, device owners, and repair partners.
            </p>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    <!-- Rating Summary Banner -->
    <div class="card border-0 shadow-sm text-center p-4" style="border-radius: 20px; border: 1px solid var(--sdm-border) !important; background: #FFFDF8;">
        <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Reputation Score</span>
        @if (reviewCount > 0)
        {
            <div class="display-5 fw-bold text-dark mb-1">
                @averageRating.ToString("0.0") <span class="text-muted fs-5">/ 5.0</span>
            </div>

            <div class="fs-4 mb-2" style="color: #F59E0B;">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Round(averageRating))
                    {
                        <i class="bi bi-star-fill"></i>
                    }
                    else
                    {
                        <i class="bi bi-star"></i>
                    }
                }
            </div>

            <span class="text-muted small">Based on <strong>@reviewCount</strong> verified review(s)</span>
        }
        else
        {
            <div class="py-2">
                <i class="bi bi-star fs-2 text-muted opacity-50 d-block mb-1"></i>
                <h5 class="fw-bold text-dark mb-1">No Reviews Yet</h5>
                <p class="text-muted small mb-0">Ratings will appear here once transactions and repairs are completed.</p>
            </div>
        }
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var review in Model)
            {
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm p-4 d-flex flex-column justify-content-between"
                         style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

                        <div>
                            <!-- Rating Stars & Header -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="fs-6" style="color: #F59E0B;">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                    <span class="text-muted small ms-1">(@review.Rating / 5)</span>
                                </div>

                                <small class="text-muted">
                                    @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </small>
                            </div>

                            <!-- Reviewer Name -->
                            <div class="mb-3">
                                <strong class="text-dark d-block">
                                    @(review.IsAnonymous ? "Anonymous Verified User" : (review.Reviewer?.FullName ?? "User"))
                                </strong>
                            </div>

                            <!-- Comment text -->
                            <div class="p-3 rounded-3 small text-secondary mb-3" style="background: #F9F8F5; border: 1px solid #ECE7DE; line-height: 1.6;">
                                @(string.IsNullOrWhiteSpace(review.Comment) ? "No written feedback provided." : review.Comment)
                            </div>
                        </div>

                        <!-- Device Info -->
                        @if (review.Offer?.Device != null)
                        {
                            <div class="pt-2 border-top small text-muted">
                                <i class="bi bi-phone me-1"></i> Transaction: <strong>@review.Offer.Device.BrandName @review.Offer.Device.ModelName</strong>
                                @if (review.Offer.Device.Category != null)
                                {
                                    <span> &bull; @review.Offer.Device.Category.Name</span>
                                }
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    }

</div>