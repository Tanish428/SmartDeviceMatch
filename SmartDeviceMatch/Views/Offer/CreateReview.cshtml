@{
    ViewData["Title"] = "Write Review";

    var offer =
        ViewBag.Offer as SmartDeviceMatch.Models.Offer;
}

<div class="container mt-4 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h2 class="mb-2">
                        Write a Review
                    </h2>

                    <p class="text-muted mb-4">
                        Share your experience with the other party.
                    </p>


                    <!-- ========================= -->
                    <!-- TRANSACTION INFORMATION -->
                    <!-- ========================= -->
                    @if (offer?.Device != null)
                    {
                        <div class="alert alert-light border">

                            <strong>
                                @offer.Device.BrandName
                                @offer.Device.ModelName
                            </strong>

                            <br />

                            <small class="text-muted">
                                @offer.Device.Category?.Name
                            </small>

                            <br />

                            <small class="text-success">
                                Transaction Completed
                            </small>

                        </div>
                    }


                    <!-- ========================= -->
                    <!-- REVIEW FORM -->
                    <!-- ========================= -->

                    <form asp-controller="Offer"
                          asp-action="CreateReview"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="offerId"
                               value="@offer?.Id" />


                        <!-- Rating -->

                        <div class="mb-4">

                            <label class="form-label">
                                Rating
                            </label>

                            <select name="rating"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Rating
                                </option>

                                <option value="5">
                                    ⭐⭐⭐⭐⭐ — Excellent
                                </option>

                                <option value="4">
                                    ⭐⭐⭐⭐ — Very Good
                                </option>

                                <option value="3">
                                    ⭐⭐⭐ — Good
                                </option>

                                <option value="2">
                                    ⭐⭐ — Poor
                                </option>

                                <option value="1">
                                    ⭐ — Very Poor
                                </option>

                            </select>

                            <span class="text-danger">
                                @Html.ValidationMessage("rating")
                            </span>

                        </div>


                        <!-- Comment -->

                        <div class="mb-4">

                            <label class="form-label">
                                Comment
                            </label>

                            <textarea name="comment"
                                      class="form-control"
                                      rows="5"
                                      maxlength="500"
                                      placeholder="Write your experience..."></textarea>

                            <div class="form-text">
                                Optional
                            </div>

                        </div>


                        <!-- Anonymous -->

                        <div class="form-check mb-4">

                            <input class="form-check-input"
                                   type="checkbox"
                                   name="isAnonymous"
                                   value="true"
                                   id="anonymousReview" />

                            <label class="form-check-label"
                                   for="anonymousReview">

                                Submit anonymously

                            </label>

                        </div>


                        <!-- Buttons -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                Submit Review

                            </button>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>