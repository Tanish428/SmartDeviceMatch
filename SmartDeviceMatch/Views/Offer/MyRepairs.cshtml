@model IEnumerable<SmartDeviceMatch.Models.Offer>

@{
    ViewData["Title"] = "My Repairs";
}

<div class="d-flex flex-column gap-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Active Repairs</h2>
            <p class="text-muted mb-0">
                Track devices currently in your workshop bench and mark them completed once tested.
            </p>
        </div>

        <span class="badge rounded-pill px-3 py-2 bg-white text-secondary border shadow-sm">
            <strong>@Model.Count()</strong> device(s) undergoing repair
        </span>
    </div>

    @if (TempData["RepairMessage"] != null)
    {
        <div class="alert alert-info rounded-3 border-0 shadow-sm">
            <i class="bi bi-info-circle me-1"></i> @TempData["RepairMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 20px; border: 1px dashed var(--sdm-border) !important;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width: 72px; height: 72px; background: #DCFCE7; color: #16A34A; font-size: 30px;">
                <i class="bi bi-wrench-adjustable-circle"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No active repairs in progress</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 440px;">
                When a device owner accepts one of your repair quotes, the device work order will appear here.
            </p>
            <div>
                <a asp-controller="Marketplace" asp-action="BrokenDevices" class="btn btn-terracotta rounded-pill px-4 py-2">
                    Browse Broken Devices
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var repair in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm sdm-card-hover p-4 d-flex flex-column justify-content-between"
                         style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

                        <div>
                            @if (repair.Device != null)
                            {
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge rounded-pill px-2 py-1 bg-light text-secondary border small">
                                        @(repair.Device.Category?.Name ?? "Hardware")
                                    </span>
                                    <span class="badge rounded-pill px-3 py-1" style="background: #FEF3C7; color: #D97706; font-weight: 600;">
                                        <i class="bi bi-gear-wide-connected me-1"></i> In Repair
                                    </span>
                                </div>

                                <h5 class="fw-bold text-dark mb-3">
                                    @repair.Device.BrandName @repair.Device.ModelName
                                </h5>

                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-muted small">Reported Damage</span>
                                    <span class="fw-semibold text-danger small">@repair.Device.DamageType</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-muted small">Condition Grade</span>
                                    <span class="badge rounded-pill bg-light text-dark border">Grade @repair.Device.ConditionGrade</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-muted small">Repair Value</span>
                                    <span class="fs-5 fw-bold" style="color: var(--sdm-primary);">
                                        ₹@repair.OfferAmount.ToString("N2")
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(repair.Message))
                                {
                                    <div class="mt-3 p-3 rounded-3 small text-secondary" style="background: #F9F8F5; border: 1px solid #ECE7DE;">
                                        <strong>Work Order Note:</strong> @repair.Message
                                    </div>
                                }
                            }
                            else
                            {
                                <h5 class="fw-bold text-dark mb-3">Device unavailable</h5>
                            }
                        </div>

                        <!-- Completion action -->
                        <div class="pt-3 mt-3 border-top">
                            <form asp-controller="Offer" asp-action="CompleteRepair" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@repair.Id" />
                                <button type="submit" class="btn btn-success rounded-pill w-100 py-2">
                                    <i class="bi bi-check-circle me-1"></i> Complete & Certify Repair
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>