@model SmartDeviceMatch.Models.RepairShop

@{
    ViewData["Title"] = "My Shop Profile";

    var specializations =
        ViewBag.Specializations
        as IEnumerable<SmartDeviceMatch.Models.ShopSpecialization>
        ?? Enumerable.Empty<SmartDeviceMatch.Models.ShopSpecialization>();
}

<div class="d-flex flex-column gap-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Shop Profile</h2>
            <p class="text-muted mb-0">
                Manage your technician credentials, verification badge, and specialized skills.
            </p>
        </div>

        <a asp-action="Edit" class="btn btn-terracotta rounded-pill px-4">
            <i class="bi bi-pencil me-1"></i> Edit Shop Profile
        </a>
    </div>

    @if (TempData["ShopMessage"] != null)
    {
        <div class="alert alert-success rounded-3 border-0 shadow-sm">
            <i class="bi bi-check-circle me-1"></i> @TempData["ShopMessage"]
        </div>
    }

    <!-- Verification Status Banner -->
    <div class="card border-0 shadow-sm p-4" style="border-radius: 20px; border: 1px solid var(--sdm-border) !important; background: #FFFFFF;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 48px; height: 48px; @(Model.IsVerified ? "background: #DCFCE7; color: #16A34A;" : "background: #FEF3C7; color: #D97706;"); font-size: 22px;">
                    <i class="bi @(Model.IsVerified ? "bi-patch-check-fill" : "bi-clock-history")"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Shop Verification</h5>
                    <small class="text-muted">Verified repair centers enjoy higher trust scores and priority matching.</small>
                </div>
            </div>

            @if (Model.IsVerified)
            {
                <span class="badge rounded-pill px-3 py-2" style="background: #DCFCE7; color: #16A34A; font-weight: 700; font-size: 13px;">
                    ✓ Verified Repair Center
                </span>
            }
            else
            {
                <span class="badge rounded-pill px-3 py-2" style="background: #FEF3C7; color: #D97706; font-weight: 700; font-size: 13px;">
                    Pending Verification
                </span>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Business Info -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">
                <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                    <i class="bi bi-building text-secondary me-2"></i>Business Information
                </h5>

                <div class="mb-3">
                    <small class="text-muted d-block">Shop Name</small>
                    <h4 class="fw-bold text-dark mb-0">@Model.ShopName</h4>
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">About / Description</small>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided yet." : Model.Description)
                    </p>
                </div>

                <div class="row g-3 py-2 border-top border-bottom my-2">
                    <div class="col-sm-6">
                        <small class="text-muted d-block">License / Registration</small>
                        <strong class="text-dark small">@(string.IsNullOrWhiteSpace(Model.LicenseNumber) ? "Not provided" : Model.LicenseNumber)</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Experience</small>
                        <strong class="text-dark small">@Model.YearsOfExperience years in business</strong>
                    </div>
                    <div class="col-12">
                        <small class="text-muted d-block">Operating Hours</small>
                        <span class="text-dark small">@(string.IsNullOrWhiteSpace(Model.OperatingHours) ? "Not specified" : Model.OperatingHours)</span>
                    </div>
                </div>

                <div class="mt-2">
                    <small class="text-muted d-block">Physical Location</small>
                    <span class="fw-semibold text-dark small"><i class="bi bi-geo-alt me-1 text-primary"></i> @Model.City, @Model.State (PIN: @Model.PinCode)</span>
                </div>
            </div>
        </div>

        <!-- Rating & Reputation -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-4 h-100 text-center d-flex flex-column justify-content-between"
                 style="border-radius: 20px; border: 1px solid var(--sdm-border) !important; background: #FFFDF8;">
                <div>
                    <h5 class="fw-bold text-dark mb-3">Service Rating</h5>

                    <div class="display-4 fw-bold text-dark mb-1">
                        @Model.Rating.ToString("0.0")
                    </div>

                    <div class="fs-4 mb-2" style="color: #F59E0B;">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.Rating))
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-star"></i>
                            }
                        }
                    </div>

                    <span class="text-muted small">Based on <strong>@Model.TotalReviews</strong> customer review(s)</span>
                </div>

                <div class="pt-4 border-top mt-4">
                    <a asp-action="Specializations" class="btn btn-terracotta-outline rounded-pill w-100">
                        <i class="bi bi-award me-1"></i> Manage Specializations
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Specializations Table Card -->
    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">
        <div class="d-flex justify-content-between align-items-center p-4 border-bottom bg-white">
            <div>
                <h5 class="fw-bold text-dark mb-0">Hardware Specializations</h5>
                <small class="text-muted">Categories and brands configured for match weighting</small>
            </div>

            <a asp-action="AddSpecialization" class="btn btn-sm btn-terracotta rounded-pill px-3">
                <i class="bi bi-plus-lg me-1"></i> Add Specialization
            </a>
        </div>

        @if (!specializations.Any())
        {
            <div class="text-center p-5">
                <i class="bi bi-award fs-1 text-muted opacity-50 d-block mb-2"></i>
                <h6 class="fw-bold text-dark">No specializations added yet</h6>
                <p class="text-muted small mb-3">Adding specializations helps matching algorithms direct relevant repair requests to you.</p>
                <a asp-action="AddSpecialization" class="btn btn-terracotta rounded-pill btn-sm px-4">
                    Add First Specialization
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background: #F9F7F3;">
                        <tr>
                            <th class="py-3 px-4 text-secondary small fw-bold text-uppercase">Category</th>
                            <th class="py-3 px-3 text-secondary small fw-bold text-uppercase">Brand</th>
                            <th class="py-3 px-3 text-secondary small fw-bold text-uppercase">Skill Level</th>
                            <th class="py-3 px-3 text-secondary small fw-bold text-uppercase">Description</th>
                            <th class="py-3 px-4 text-secondary small fw-bold text-uppercase text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var spec in specializations)
                        {
                            <tr style="border-bottom: 1px solid #F4EFEA;">
                                <td class="py-3 px-4 fw-bold text-dark">
                                    @(spec.Category?.Name ?? "General")
                                </td>
                                <td class="py-3 px-3 text-secondary">
                                    @(string.IsNullOrWhiteSpace(spec.BrandName) ? "All Brands" : spec.BrandName)
                                </td>
                                <td class="py-3 px-3" style="color: #F59E0B;">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= spec.ExpertiseLevel)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </td>
                                <td class="py-3 px-3 small text-muted">
                                    @(string.IsNullOrWhiteSpace(spec.Description) ? "—" : spec.Description)
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="EditSpecialization" asp-route-id="@spec.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            Edit
                                        </a>

                                        <form asp-action="DeleteSpecialization" asp-route-id="@spec.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Remove this specialization?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>