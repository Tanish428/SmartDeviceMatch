@model SmartDeviceMatch.Models.RepairShop

@{
    ViewData["Title"] = "My Shop Profile";

    var specializations =
        ViewBag.Specializations
        as IEnumerable<SmartDeviceMatch.Models.ShopSpecialization>
        ?? Enumerable.Empty<SmartDeviceMatch.Models.ShopSpecialization>();
}

<div class="container mt-4 mb-5">

    @if (TempData["ShopMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["ShopMessage"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>My Shop Profile</h2>

            <p class="text-muted mb-0">
                Manage your repair shop information and expertise.
            </p>
        </div>

        <a asp-action="Edit"
           class="btn btn-primary">
            Edit Shop Profile
        </a>

    </div>


    <!-- Verification Status -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-1">
                        Verification Status
                    </h5>

                    <small class="text-muted">
                        Shop verification is controlled by the administrator.
                    </small>
                </div>

                @if (Model.IsVerified)
                {
                    <span class="badge bg-success fs-6">
                        ✓ Verified
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark fs-6">
                        Pending Verification
                    </span>
                }

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- Shop Information -->

        <div class="col-lg-7">

            <div class="card shadow-sm h-100">

                <div class="card-header">
                    <h5 class="mb-0">
                        Business Information
                    </h5>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <small class="text-muted">
                            Shop Name
                        </small>

                        <h5>
                            @Model.ShopName
                        </h5>
                    </div>

                    <div class="mb-3">

                        <small class="text-muted">
                            Description
                        </small>

                        <p>
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description provided."
                                : Model.Description)
                        </p>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <small class="text-muted">
                                License Number
                            </small>

                            <div>
                                @(string.IsNullOrWhiteSpace(Model.LicenseNumber)
                                    ? "Not provided"
                                    : Model.LicenseNumber)
                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <small class="text-muted">
                                Years of Experience
                            </small>

                            <div>
                                @Model.YearsOfExperience years
                            </div>

                        </div>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted">
                            Operating Hours
                        </small>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.OperatingHours)
                                ? "Not provided"
                                : Model.OperatingHours)
                        </div>

                    </div>


                    <hr />

                    <h6>Location</h6>

                    <p class="mb-1">
                        @Model.City, @Model.State
                    </p>

                    <p class="text-muted">
                        PIN: @Model.PinCode
                    </p>

                </div>

            </div>

        </div>


        <!-- Rating -->

        <div class="col-lg-5">

            <div class="card shadow-sm h-100">

                <div class="card-header">
                    <h5 class="mb-0">
                        Shop Rating
                    </h5>
                </div>

                <div class="card-body text-center">

                    <h1 class="display-4">
                        @Model.Rating.ToString("0.0")
                    </h1>

                    <div class="mb-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.Rating))
                            {
                                <span class="text-warning fs-4">★</span>
                            }
                            else
                            {
                                <span class="text-muted fs-4">☆</span>
                            }
                        }
                    </div>

                    <p class="text-muted">
                        @Model.TotalReviews review(s)
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Specializations -->

    <div class="card shadow-sm mt-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                Shop Specializations
            </h5>

            <a asp-action="AddSpecialization"
               class="btn btn-sm btn-primary">
                + Add Specialization
            </a>

        </div>


        <div class="card-body">

            @if (!specializations.Any())
            {
                <div class="text-center py-4">

                    <h6>
                        No specializations added yet.
                    </h6>

                    <p class="text-muted">
                        Add categories and brands that your shop specializes in.
                    </p>

                    <a asp-action="AddSpecialization"
                       class="btn btn-primary">
                        Add Your First Specialization
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Category</th>
                                <th>Brand</th>
                                <th>Expertise</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var specialization in specializations)
                            {
                                <tr>

                                    <td>
                                        @specialization.Category?.Name
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            specialization.BrandName)
                                            ? "All Brands"
                                            : specialization.BrandName)
                                    </td>

                                    <td>

                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= specialization.ExpertiseLevel)
                                            {
                                                <span class="text-warning">
                                                    ★
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    ☆
                                                </span>
                                            }
                                        }

                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            specialization.Description)
                                            ? "—"
                                            : specialization.Description)
                                    </td>

                                    <td>

                                        <a asp-action="EditSpecialization"
                                           asp-route-id="@specialization.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <form asp-action="DeleteSpecialization"
                                              asp-route-id="@specialization.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Remove this specialization?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>