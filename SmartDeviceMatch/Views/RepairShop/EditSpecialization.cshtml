@model SmartDeviceMatch.Models.ShopSpecialization

@{
    ViewData["Title"] = "Edit Specialization";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

            <!-- Header -->
            <div class="p-4 p-md-5" style="background: linear-gradient(135deg, #FFF8F4 0%, #FAEDE4 100%); border-bottom: 1px solid #F3E4DA;">
                <span class="badge rounded-pill px-3 py-1 mb-2" style="background: var(--sdm-primary-light); color: var(--sdm-primary); font-weight: 600;">
                    Repair Expertise
                </span>
                <h3 class="fw-bold text-dark mb-1">Edit Specialization</h3>
                <p class="text-muted small mb-0">Update your shop's expertise level and descriptions.</p>
            </div>

            <div class="card-body p-4 p-md-5">

                <form asp-action="EditSpecialization" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold text-dark">Device Category</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" required>
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Brand -->
                    <div class="mb-3">
                        <label asp-for="BrandName" class="form-label fw-semibold text-dark">Brand</label>
                        <input asp-for="BrandName" class="form-control" placeholder="Leave empty for all brands" />
                        <span asp-validation-for="BrandName" class="text-danger small"></span>
                    </div>

                    <!-- Expertise Level -->
                    <div class="mb-3">
                        <label asp-for="ExpertiseLevel" class="form-label fw-semibold text-dark">Expertise Level</label>
                        <select asp-for="ExpertiseLevel" class="form-select" required>
                            <option value="5">★★★★★ — 5 (Expert Master Technician)</option>
                            <option value="4">★★★★☆ — 4 (Advanced Repair Capability)</option>
                            <option value="3">★★★☆☆ — 3 (Intermediate / Standard Fixes)</option>
                            <option value="2">★★☆☆☆ — 2 (Basic Screen & Battery Replacements)</option>
                            <option value="1">★☆☆☆☆ — 1 (Beginner)</option>
                        </select>
                        <span asp-validation-for="ExpertiseLevel" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold text-dark">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2">
                        <a asp-action="Specializations" class="btn btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-terracotta rounded-pill px-5">
                            Save Changes
                        </button>
                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}