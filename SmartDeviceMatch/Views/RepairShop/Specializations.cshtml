@model IEnumerable<SmartDeviceMatch.Models.ShopSpecialization>

@{
    ViewData["Title"] = "My Specializations";
}

<div class="d-flex flex-column gap-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">My Specializations</h2>
            <p class="text-muted mb-0">
                Configure your repair strengths across device categories and specific hardware brands.
            </p>
        </div>

        <a asp-action="AddSpecialization" class="btn btn-terracotta rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Add Specialization
        </a>
    </div>

    @if (TempData["ShopMessage"] != null)
    {
        <div class="alert alert-success rounded-3 border-0 shadow-sm">
            <i class="bi bi-check-circle me-1"></i> @TempData["ShopMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 20px; border: 1px dashed var(--sdm-border) !important;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width: 72px; height: 72px; background: #FEF3C7; color: #D97706; font-size: 30px;">
                <i class="bi bi-award"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No specializations configured</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 440px;">
                Add device categories, brands, and skill levels so matching algorithms can automatically direct ideal repair jobs to you.
            </p>
            <div>
                <a asp-action="AddSpecialization" class="btn btn-terracotta rounded-pill px-4 py-2">
                    Add First Specialization
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background: #F9F7F3;">
                        <tr>
                            <th class="py-3 px-4 text-secondary small fw-bold text-uppercase">Category</th>
                            <th class="py-3 px-3 text-secondary small fw-bold text-uppercase">Brand</th>
                            <th class="py-3 px-3 text-secondary small fw-bold text-uppercase">Skill Level</th>
                            <th class="py-3 px-3 text-secondary small fw-bold text-uppercase">Description</th>
                            <th class="py-3 px-4 text-secondary small fw-bold text-uppercase text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="border-bottom: 1px solid #F4EFEA;">
                                <td class="py-3 px-4 fw-bold text-dark">
                                    @(item.Category?.Name ?? "General")
                                </td>
                                <td class="py-3 px-3 text-secondary">
                                    @(string.IsNullOrWhiteSpace(item.BrandName) ? "All Brands" : item.BrandName)
                                </td>
                                <td class="py-3 px-3" style="color: #F59E0B;">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= item.ExpertiseLevel)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </td>
                                <td class="py-3 px-3 small text-muted">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="EditSpecialization" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            Edit
                                        </a>

                                        <form asp-action="DeleteSpecialization" asp-route-id="@item.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to remove this specialization?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>