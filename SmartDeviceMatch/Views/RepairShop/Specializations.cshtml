@model IEnumerable<SmartDeviceMatch.Models.ShopSpecialization>

@{
    ViewData["Title"] = "My Specializations";
}

<div class="container mt-4 mb-5">

    @if (TempData["ShopMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["ShopMessage"]
        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>My Specializations</h2>

            <p class="text-muted mb-0">
                Manage the device categories and brands your shop specializes in.
            </p>

        </div>

        <a asp-action="AddSpecialization"
           class="btn btn-primary">
            + Add Specialization
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center p-5">

                <h5>No specializations found.</h5>

                <p class="text-muted">
                    Add your first category and expertise.
                </p>

                <a asp-action="AddSpecialization"
                   class="btn btn-primary">
                    Add Specialization
                </a>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Category</th>
                                <th>Brand</th>
                                <th>Expertise</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @item.Category?.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.BrandName)
                                            ? "All Brands"
                                            : item.BrandName)
                                    </td>

                                    <td>

                                        <span class="me-2">
                                            @item.ExpertiseLevel / 5
                                        </span>

                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= item.ExpertiseLevel)
                                            {
                                                <span class="text-warning">
                                                    ★
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    ☆
                                                </span>
                                            }
                                        }

                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Description)
                                            ? "—"
                                            : item.Description)
                                    </td>

                                    <td>

                                        <a asp-action="EditSpecialization"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <form asp-action="DeleteSpecialization"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to remove this specialization?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>