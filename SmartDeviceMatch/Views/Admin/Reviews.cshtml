@model IEnumerable<SmartDeviceMatch.Models.Review>

@{
    ViewData["Title"] = "All Reviews";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>All Reviews</h2>

            <p class="text-muted">
                Monitor reviews submitted by marketplace users.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <p class="text-muted">
                    No reviews found.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>
                                <th>Reviewer</th>
                                <th>Reviewee</th>
                                <th>Rating</th>
                                <th>Comment</th>
                                <th>Date</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var review in Model)
                            {
                                <tr>

                                    <td>

                                        @if (review.IsAnonymous)
                                        {
                                            <span>
                                                Anonymous User
                                            </span>
                                        }
                                        else
                                        {
                                            @review.Reviewer?.FullName
                                        }

                                    </td>

                                    <td>
                                        @review.Reviewee?.FullName
                                    </td>

                                    <td>

                                        <span class="text-warning">

                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <span>★</span>
                                                }
                                                else
                                                {
                                                    <span>☆</span>
                                                }
                                            }

                                        </span>

                                        <small>
                                            (@review.Rating/5)
                                        </small>

                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(review.Comment)
                                            ? "No comment"
                                            : review.Comment)
                                    </td>

                                    <td>
                                        @review.CreatedAt
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>