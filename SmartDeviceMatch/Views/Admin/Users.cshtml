@model IEnumerable<SmartDeviceMatch.Models.AppUser>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Manage Users</h2>
            <p class="text-muted">
                View and manage registered users.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>


    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["AdminMessage"]
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <p class="text-muted">
                    No users found.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>
                                <th>Name</th>
                                <th>Role</th>
                                <th>Location</th>
                                <th>Rating</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var user in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @user.FullName
                                        </strong>
                                    </td>

                                    <td>
                                        @user.UserType
                                    </td>

                                    <td>
                                        @(user.City ?? "-"),
                                        @(user.State ?? "-")
                                    </td>

                                    <td>
                                        @user.Rating.ToString("0.0")
                                    </td>

                                    <td>

                                        @if (user.IsBanned)
                                        {
                                            <span class="badge bg-danger">
                                                Banned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (user.UserType != "Admin")
                                        {
                                            @if (user.IsBanned)
                                            {
                                                <form asp-action="UnbanUser"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@user.Id" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-success">
                                                        Unban
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="BanUser"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@user.Id" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger">
                                                        Ban
                                                    </button>

                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Admin
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>