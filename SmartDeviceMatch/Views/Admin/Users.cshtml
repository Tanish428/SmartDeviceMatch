@model IEnumerable<SmartDeviceMatch.Models.AppUser>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container-fluid px-0">

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-4 mb-4" role="alert" style="border: 1px solid #BFDBFE; background: #EFF6FF; color: #1E40AF;">
            <i class="bi bi-info-circle me-2"></i> @TempData["AdminMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill" style="background: rgba(186, 60, 42, 0.1); color: var(--sdm-primary); font-weight: 600;">
                    <i class="bi bi-shield-lock me-1"></i> Admin Console
                </span>
            </div>
            <h2 class="fw-bold text-dark mb-1">Manage Users</h2>
            <p class="text-muted small mb-0">
                View, monitor, and regulate user accounts, permissions, and security bans.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- Users Table Card -->
    <div class="card sdm-card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark">
                <i class="bi bi-people me-2 text-muted"></i>All Registered Users
            </span>
            <span class="badge rounded-pill bg-light text-secondary border px-3 py-2">
                Total: @Model.Count()
            </span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 64px; height: 64px; background: #F8F6F2; color: #8C827A;">
                        <i class="bi bi-people" style="font-size: 28px;"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">No users found</h5>
                    <p class="text-muted small mb-0">There are currently no registered users in the database.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background: #FAF8F5; font-size: 0.85rem;" class="text-uppercase text-muted border-bottom">
                            <tr>
                                <th class="ps-4 py-3">User</th>
                                <th class="py-3">Role</th>
                                <th class="py-3">Location</th>
                                <th class="py-3">Rating</th>
                                <th class="py-3">Status</th>
                                <th class="pe-4 py-3 text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 40px; height: 40px; background: #FFF0ED; color: var(--sdm-primary);">
                                                @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@user.FullName</div>
                                                <small class="text-muted font-monospace">User #@user.Id</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        @if (user.UserType == "Admin")
                                        {
                                            <span class="badge rounded-pill bg-dark text-white px-3 py-1">
                                                <i class="bi bi-shield-shaded me-1"></i>Admin
                                            </span>
                                        }
                                        else if (user.UserType == "RepairShop")
                                        {
                                            <span class="badge rounded-pill" style="background: rgba(245, 158, 11, 0.15); color: #D97706; font-weight: 600;">
                                                <i class="bi bi-tools me-1"></i>Repair Shop
                                            </span>
                                        }
                                        else if (user.UserType == "Buyer")
                                        {
                                            <span class="badge rounded-pill" style="background: rgba(37, 99, 235, 0.1); color: #2563EB; font-weight: 600;">
                                                <i class="bi bi-bag me-1"></i>Buyer
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill" style="background: rgba(16, 185, 129, 0.12); color: #059669; font-weight: 600;">
                                                <i class="bi bi-phone me-1"></i>Device Owner
                                            </span>
                                        }
                                    </td>

                                    <td class="py-3">
                                        <span class="text-dark">@(user.City ?? "-"), @(user.State ?? "-")</span>
                                    </td>

                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-1">
                                            <i class="bi bi-star-fill text-warning"></i>
                                            <span class="fw-semibold text-dark">@user.Rating.ToString("0.0")</span>
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        @if (user.IsBanned)
                                        {
                                            <span class="badge rounded-pill bg-light text-danger border border-danger-subtle px-3 py-1">
                                                <i class="bi bi-slash-circle me-1"></i>Banned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill" style="background: rgba(16, 185, 129, 0.12); color: #059669; font-weight: 600;">
                                                <i class="bi bi-check-circle me-1"></i>Active
                                            </span>
                                        }
                                    </td>

                                    <td class="pe-4 py-3 text-end">
                                        @if (user.UserType != "Admin")
                                        {
                                            @if (user.IsBanned)
                                            {
                                                <form asp-action="UnbanUser" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-none">
                                                        <i class="bi bi-unlock me-1"></i> Unban
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="BanUser" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-none"
                                                            onclick="return confirm('Are you sure you want to ban this user?');">
                                                        <i class="bi bi-slash-circle me-1"></i> Ban User
                                                    </button>
                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-light text-muted border px-2 py-1">
                                                Protected
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>