@model IEnumerable<SmartDeviceMatch.Models.Dispute>

@{
    ViewData["Title"] = "Dispute Management";
}

<div class="container-fluid px-0">

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-4 mb-4" role="alert" style="border: 1px solid #BFDBFE; background: #EFF6FF; color: #1E40AF;">
            <i class="bi bi-info-circle me-2"></i> @TempData["AdminMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill" style="background: rgba(186, 60, 42, 0.1); color: var(--sdm-primary); font-weight: 600;">
                    <i class="bi bi-shield-lock me-1"></i> Admin Console
                </span>
            </div>
            <h2 class="fw-bold text-dark mb-1">Dispute Management</h2>
            <p class="text-muted small mb-0">
                Arbitrate escrow conflicts, review evidence, and determine final transaction resolutions.
            </p>
        </div>

        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- Disputes Card Table -->
    <div class="card sdm-card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark">
                <i class="bi bi-exclamation-triangle me-2 text-warning"></i>Active & Resolved Disputes
            </span>
            <span class="badge rounded-pill bg-light text-secondary border px-3 py-2">
                Total: @Model.Count()
            </span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 64px; height: 64px; background: #F8F6F2; color: #8C827A;">
                        <i class="bi bi-shield-check" style="font-size: 28px;"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">No disputes found</h5>
                    <p class="text-muted small mb-0">No active complaints or reported issues in the marketplace.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background: #FAF8F5; font-size: 0.85rem;" class="text-uppercase text-muted border-bottom">
                            <tr>
                                <th class="ps-4 py-3">Case ID</th>
                                <th class="py-3">Offer / Device</th>
                                <th class="py-3">Reported By</th>
                                <th class="py-3" style="width: 25%;">Reason</th>
                                <th class="py-3">Status</th>
                                <th class="py-3">Reported At</th>
                                <th class="pe-4 py-3 text-end" style="min-width: 280px;">Admin Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var dispute in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <span class="fw-bold text-dark font-monospace">#@dispute.Id</span>
                                    </td>

                                    <td class="py-3">
                                        <div class="fw-semibold text-dark">Offer #@dispute.OfferId</div>
                                        <small class="text-muted">
                                            @(dispute.Offer?.Device?.BrandName) @(dispute.Offer?.Device?.ModelName)
                                        </small>
                                    </td>

                                    <td class="py-3">
                                        <span class="fw-semibold text-dark">
                                            @(dispute.RaisedByUser?.FullName ?? "Unknown User")
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <div class="p-2 rounded-3 bg-light border small text-dark">
                                            @dispute.Reason
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        @if (dispute.Status == "Open")
                                        {
                                            <span class="badge rounded-pill bg-light text-danger border border-danger-subtle px-3 py-1">
                                                <i class="bi bi-exclamation-circle me-1"></i>Open
                                            </span>
                                        }
                                        else if (dispute.Status == "UnderReview")
                                        {
                                            <span class="badge rounded-pill" style="background: rgba(245, 158, 11, 0.15); color: #D97706; font-weight: 600;">
                                                <i class="bi bi-search me-1"></i>Under Review
                                            </span>
                                        }
                                        else if (dispute.Status == "Resolved")
                                        {
                                            <span class="badge rounded-pill" style="background: rgba(16, 185, 129, 0.12); color: #059669; font-weight: 600;">
                                                <i class="bi bi-check-circle me-1"></i>Resolved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-light text-secondary border px-3 py-1">
                                                Rejected
                                            </span>
                                        }
                                    </td>

                                    <td class="py-3 text-muted small">
                                        @dispute.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>

                                    <td class="pe-4 py-3 text-end">
                                        <div class="p-3 rounded-3 text-start" style="background: #F9F8F5; border: 1px solid #ECE7DE;">
                                            <form asp-controller="Admin" asp-action="ResolveDispute" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@dispute.Id" />

                                                <label class="form-label small fw-semibold text-muted mb-1">Update Status</label>
                                                <select name="status" class="form-select form-select-sm mb-2 rounded-3" required>
                                                    <option value="UnderReview" selected="@(dispute.Status == "UnderReview")">
                                                        Under Review
                                                    </option>
                                                    <option value="Resolved">Resolved</option>
                                                    <option value="Rejected">Rejected</option>
                                                </select>

                                                <label class="form-label small fw-semibold text-muted mb-1">Resolution Note</label>
                                                <textarea name="adminResolution" class="form-control form-control-sm mb-2 rounded-3"
                                                          rows="2" maxlength="1500"
                                                          placeholder="Decision or resolution reason...">@dispute.AdminResolution</textarea>

                                                <button type="submit" class="btn btn-terracotta btn-sm rounded-pill w-100">
                                                    <i class="bi bi-check2-circle me-1"></i> Update Case
                                                </button>
                                            </form>

                                            @if (!string.IsNullOrWhiteSpace(dispute.AdminResolution))
                                            {
                                                <div class="mt-2 pt-2 border-top small text-muted">
                                                    <strong>Last note:</strong> @dispute.AdminResolution
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>