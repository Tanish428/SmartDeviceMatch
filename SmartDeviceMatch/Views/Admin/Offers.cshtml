@model IEnumerable<SmartDeviceMatch.Models.Offer>

@{
    ViewData["Title"] = "Manage Offers";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Offers</h2>
            <p class="text-muted mb-0">
                View all offers and transactions on SmartDeviceMatch.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Dashboard
        </a>
    </div>


    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">
                <h5>No offers found</h5>
                <p class="text-muted mb-0">
                    There are currently no offers in the system.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Device</th>
                                <th>Offer Type</th>
                                <th>Buyer</th>
                                <th>Repair Shop</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Expires</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var offer in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>#@offer.Id</strong>
                                    </td>


                                    <td>
                                        @if (offer.Device != null)
                                        {
                                            <div>
                                                <strong>
                                                    @offer.Device.BrandName
                                                    @offer.Device.ModelName
                                                </strong>

                                                <br />

                                                <small class="text-muted">
                                                    @offer.Device.Category?.Name
                                                </small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Device unavailable
                                            </span>
                                        }
                                    </td>


                                    <td>

                                        @if (offer.OfferType == "Repair")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Repair
                                            </span>
                                        }
                                        else if (offer.OfferType == "Buy")
                                        {
                                            <span class="badge bg-primary">
                                                Buy
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @offer.OfferType
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @if (offer.Buyer != null)
                                        {
                                            @offer.Buyer.FullName
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>


                                    <td>
                                        @if (offer.RepairShop?.User != null)
                                        {
                                            @offer.RepairShop.User.FullName
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>


                                    <td>
                                        <strong>
                                            @offer.Currency
                                            @offer.OfferAmount.ToString("N2")
                                        </strong>
                                    </td>


                                    <td>

                                        @if (offer.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (offer.Status == "Accepted")
                                        {
                                            <span class="badge bg-success">
                                                Accepted
                                            </span>
                                        }
                                        else if (offer.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else if (offer.Status == "Escrowed")
                                        {
                                            <span class="badge bg-primary">
                                                Escrowed
                                            </span>
                                        }
                                        else if (offer.Status == "Verified")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Verified
                                            </span>
                                        }
                                        else if (offer.Status == "Released")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Released
                                            </span>
                                        }
                                        else if (offer.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @offer.Status
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @offer.ExpiresAt.ToString("dd MMM yyyy")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>