@model IEnumerable<SmartDeviceMatch.Models.RepairShop>

@{
    ViewData["Title"] = "Repair Shop Verification";
}

<div class="container-fluid px-0">

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert" style="border: 1px solid #A7F3D0; background: #ECFDF5; color: #065F46;">
            <i class="bi bi-check-circle me-2"></i> @TempData["AdminMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill" style="background: rgba(186, 60, 42, 0.1); color: var(--sdm-primary); font-weight: 600;">
                    <i class="bi bi-shield-lock me-1"></i> Admin Console
                </span>
            </div>
            <h2 class="fw-bold text-dark mb-1">Repair Shop Verification</h2>
            <p class="text-muted small mb-0">
                Review credential documents, business licenses, and grant verified partner status to service workshops.
            </p>
        </div>

        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card sdm-card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width: 64px; height: 64px; background: #F8F6F2; color: #8C827A;">
                    <i class="bi bi-wrench" style="font-size: 28px;"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">No repair shops found</h5>
                <p class="text-muted small mb-0">No repair shop profiles have been registered yet.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card sdm-card border-0 shadow-sm overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark">
                    <i class="bi bi-tools me-2 text-muted"></i>Registered Service Centers
                </span>
                <span class="badge rounded-pill bg-light text-secondary border px-3 py-2">
                    Total: @Model.Count()
                </span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background: #FAF8F5; font-size: 0.85rem;" class="text-uppercase text-muted border-bottom">
                            <tr>
                                <th class="ps-4 py-3">Shop Name</th>
                                <th class="py-3">Owner</th>
                                <th class="py-3">Location</th>
                                <th class="py-3">Experience</th>
                                <th class="py-3">License</th>
                                <th class="py-3">Rating</th>
                                <th class="py-3">Status</th>
                                <th class="pe-4 py-3 text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var shop in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-dark">@shop.ShopName</div>
                                        @if (!string.IsNullOrWhiteSpace(shop.Description))
                                        {
                                            <small class="text-muted d-block text-truncate" style="max-width: 220px;">
                                                @shop.Description
                                            </small>
                                        }
                                    </td>

                                    <td class="py-3">
                                        <span class="fw-semibold text-dark">@(shop.User?.FullName ?? "—")</span>
                                    </td>

                                    <td class="py-3">
                                        <div>@shop.City, @shop.State</div>
                                        <small class="text-muted">PIN: @shop.PinCode</small>
                                    </td>

                                    <td class="py-3">
                                        <span class="badge rounded-pill bg-light text-secondary border px-3 py-1">
                                            @shop.YearsOfExperience yrs exp
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <span class="font-monospace small text-muted">
                                            @(string.IsNullOrWhiteSpace(shop.LicenseNumber) ? "None" : shop.LicenseNumber)
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-1 text-warning fw-semibold">
                                            <i class="bi bi-star-fill text-warning"></i>
                                            <span class="text-dark">@shop.Rating.ToString("0.0")</span>
                                            <small class="text-muted">(@shop.TotalReviews)</small>
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        @if (shop.IsVerified)
                                        {
                                            <span class="badge rounded-pill" style="background: rgba(16, 185, 129, 0.12); color: #059669; font-weight: 600;">
                                                <i class="bi bi-patch-check-fill me-1"></i>Verified
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill" style="background: rgba(245, 158, 11, 0.15); color: #D97706; font-weight: 600;">
                                                <i class="bi bi-hourglass-split me-1"></i>Pending
                                            </span>
                                        }
                                    </td>

                                    <td class="pe-4 py-3 text-end">
                                        @if (!shop.IsVerified)
                                        {
                                            <form asp-action="VerifyRepairShop" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@shop.Id" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 shadow-none">
                                                    <i class="bi bi-check-lg me-1"></i> Verify
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="UnverifyRepairShop" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@shop.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                        onclick="return confirm('Remove verification from this shop?');">
                                                    <i class="bi bi-x-circle me-1"></i> Unverify
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>