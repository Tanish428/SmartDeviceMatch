@model IEnumerable<SmartDeviceMatch.Models.RepairShop>

@{
    ViewData["Title"] = "Repair Shop Verification";
}

<div class="container mt-4 mb-5">

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["AdminMessage"]
        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Repair Shop Verification</h2>

            <p class="text-muted mb-0">
                Review and manage repair shop verification.
            </p>

        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Dashboard
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center p-5">

                <h5>No repair shops found.</h5>

                <p class="text-muted mb-0">
                    No repair shop profiles have been created yet.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Shop</th>
                                <th>Owner</th>
                                <th>Location</th>
                                <th>Experience</th>
                                <th>License</th>
                                <th>Rating</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var shop in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @shop.ShopName
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(
                                            shop.Description))
                                        {
                                            <br />

                                            <small class="text-muted">
                                                @shop.Description
                                            </small>
                                        }
                                    </td>


                                    <td>
                                        @(shop.User?.FullName ?? "—")
                                    </td>


                                    <td>
                                        @shop.City,
                                        @shop.State

                                        <br />

                                        <small class="text-muted">
                                            @shop.PinCode
                                        </small>
                                    </td>


                                    <td>
                                        @shop.YearsOfExperience years
                                    </td>


                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            shop.LicenseNumber)
                                            ? "Not provided"
                                            : shop.LicenseNumber)
                                    </td>


                                    <td>
                                        @shop.Rating.ToString("0.0")
                                        <small class="text-muted">
                                            (@shop.TotalReviews)
                                        </small>
                                    </td>


                                    <td>

                                        @if (shop.IsVerified)
                                        {
                                            <span class="badge bg-success">
                                                Verified
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (!shop.IsVerified)
                                        {
                                            <form asp-action="VerifyRepairShop"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@shop.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">
                                                    Verify
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="UnverifyRepairShop"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@shop.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Remove verification from this shop?');">
                                                    Unverify
                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>