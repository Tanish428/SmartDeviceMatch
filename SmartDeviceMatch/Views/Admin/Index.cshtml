@model SmartDeviceMatch.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4 mb-5">

    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Admin Dashboard</h2>
            <p class="text-muted mb-0">
                Monitor marketplace performance and platform activity.
            </p>
        </div>

        <span class="badge bg-dark p-2">
            Administrator
        </span>
    </div>

    <!-- ADMIN MESSAGE -->
    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @TempData["AdminMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- USER ANALYTICS -->
    <h5 class="fw-semibold mb-3">User Analytics</h5>

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Total Users</small>
                    <h3 class="fw-bold mt-2">@Model.TotalUsers</h3>
                    <small class="text-muted">Registered profiles</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Device Owners</small>
                    <h3 class="fw-bold mt-2">@Model.DeviceOwners</h3>
                    <small class="text-muted">Listing users</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Buyers</small>
                    <h3 class="fw-bold mt-2">@Model.Buyers</h3>
                    <small class="text-muted">Marketplace buyers</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Banned Users</small>
                    <h3 class="fw-bold mt-2">@Model.BannedUsers</h3>
                    <small class="text-muted">Restricted accounts</small>
                </div>
            </div>
        </div>

    </div>

    <!-- REPAIR SHOP ANALYTICS -->
    <h5 class="fw-semibold mb-3">Repair Shop Analytics</h5>

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Total Repair Shops</small>
                    <h3 class="fw-bold mt-2">@Model.TotalRepairShops</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Verified Shops</small>
                    <h3 class="fw-bold text-success mt-2">
                        @Model.VerifiedRepairShops
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Pending Verification</small>
                    <h3 class="fw-bold text-warning mt-2">
                        @Model.PendingRepairShops
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- MARKETPLACE ANALYTICS -->
    <h5 class="fw-semibold mb-3">Marketplace Analytics</h5>

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Total Devices</small>
                    <h3 class="fw-bold mt-2">@Model.TotalDevices</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Active Listings</small>
                    <h3 class="fw-bold text-primary mt-2">
                        @Model.ActiveListings
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Urgent Listings</small>
                    <h3 class="fw-bold text-danger mt-2">
                        @Model.UrgentListings
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Deleted Listings</small>
                    <h3 class="fw-bold mt-2">@Model.DeletedDevices</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Devices in Repair</small>
                    <h3 class="fw-bold mt-2">@Model.DevicesInRepair</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Refurbished Devices</small>
                    <h3 class="fw-bold mt-2">@Model.RefurbishedDevices</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Total Offers</small>
                    <h3 class="fw-bold mt-2">@Model.TotalOffers</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- TRANSACTION ANALYTICS -->
    <h5 class="fw-semibold mb-3">Transaction Analytics</h5>

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Pending Offers</small>
                    <h3 class="fw-bold mt-2">@Model.PendingOffers</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Accepted Offers</small>
                    <h3 class="fw-bold mt-2">@Model.AcceptedOffers</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Escrowed Transactions</small>
                    <h3 class="fw-bold text-warning mt-2">
                        @Model.EscrowedTransactions
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Completed Transactions</small>
                    <h3 class="fw-bold text-success mt-2">
                        @Model.CompletedTransactions
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- MATCH AND REVIEW ANALYTICS -->
    <h5 class="fw-semibold mb-3">Platform Performance</h5>

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Total Matches</small>
                    <h3 class="fw-bold mt-2">@Model.TotalMatches</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Active Matches</small>
                    <h3 class="fw-bold mt-2">@Model.ActiveMatches</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Total Reviews</small>
                    <h3 class="fw-bold mt-2">@Model.TotalReviews</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Average Rating</small>
                    <h3 class="fw-bold text-warning mt-2">
                        @Model.AverageRating.ToString("0.0") / 5
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- CHART DATA -->
    <div class="row g-3 mb-4">

        <!-- SIX MONTH LISTING TREND -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <h5 class="fw-semibold mb-3">
                        Device Listing Trend
                    </h5>

                    <p class="text-muted small">
                        Listings created during the last six months.
                    </p>

                    @{
                        var maxListingCount = Model.MonthlyListings
                            .Select(x => x.Count)
                            .DefaultIfEmpty(0)
                            .Max();
                    }

                    @foreach (var item in Model.MonthlyListings)
                    {
                        var barWidth = maxListingCount > 0
                            ? (double)item.Count / maxListingCount * 100
                            : 0;

                        <div class="mb-3">

                            <div class="d-flex justify-content-between mb-1">
                                <small>@item.Month</small>
                                <small class="fw-semibold">@item.Count</small>
                            </div>

                            <div class="progress"
                                 style="height: 12px;"
                                 role="progressbar"
                                 aria-valuenow="@item.Count"
                                 aria-valuemin="0"
                                 aria-valuemax="@maxListingCount">

                                <div class="progress-bar bg-primary"
                                     style="width: @barWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                                </div>

                            </div>

                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- DEVICE STATUS -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <h5 class="fw-semibold mb-3">
                        Device Status Breakdown
                    </h5>

                    @if (Model.DeviceStatuses.Count == 0)
                    {
                        <p class="text-muted">
                            No active device records available.
                        </p>
                    }
                    else
                    {
                        @foreach (var item in Model.DeviceStatuses)
                        {
                            <div class="d-flex justify-content-between
                                align-items-center border-bottom py-3">

                                <span>@item.Status</span>

                                <span class="badge bg-primary rounded-pill">
                                    @item.Count
                                </span>

                            </div>
                        }
                    }

                </div>
            </div>
        </div>

    </div>

    <!-- RECENT USERS -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between
                align-items-center mb-3">

                <h5 class="fw-semibold mb-0">Recent Users</h5>

                <a asp-action="Users"
                   class="btn btn-sm btn-outline-primary">
                    View All
                </a>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Role</th>
                            <th>City</th>
                            <th>Joined</th>
                            <th>Account</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.RecentUsers.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted">
                                    No users found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model.RecentUsers)
                            {
                                <tr>
                                    <td>@user.FullName</td>
                                    <td>@user.UserType</td>
                                    <td>@(user.City ?? "N/A")</td>
                                    <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (user.IsBanned)
                                        {
                                            <span class="badge bg-danger">
                                                Banned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>

    <!-- RECENT OFFERS -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between
                align-items-center mb-3">

                <h5 class="fw-semibold mb-0">Recent Offers</h5>

                <a asp-action="Offers"
                   class="btn btn-sm btn-outline-primary">
                    View All
                </a>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Offer ID</th>
                            <th>Device</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.RecentOffers.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted">
                                    No offers found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var offer in Model.RecentOffers)
                            {
                                <tr>
                                    <td>#@offer.Id</td>

                                    <td>
                                        @(offer.Device?.BrandName ?? "N/A")
                                        @(offer.Device?.ModelName ?? "")
                                    </td>

                                    <td>@offer.OfferType</td>

                                    <td>
                                        @offer.Currency
                                        @offer.OfferAmount.ToString("N2")
                                    </td>

                                    <td>
                                        @if (offer.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                @offer.Status
                                            </span>
                                        }
                                        else if (offer.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @offer.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @offer.Status
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>

    <!-- RECENT REVIEWS -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between
                align-items-center mb-3">

                <h5 class="fw-semibold mb-0">Recent Reviews</h5>

                <a asp-action="Reviews"
                   class="btn btn-sm btn-outline-primary">
                    View All
                </a>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Reviewer</th>
                            <th>Reviewee</th>
                            <th>Rating</th>
                            <th>Comment</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.RecentReviews.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted">
                                    No reviews found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var review in Model.RecentReviews)
                            {
                                <tr>
                                    <td>
                                        @(review.IsAnonymous
                                            ? "Anonymous"
                                            : review.Reviewer?.FullName ?? "N/A")
                                    </td>

                                    <td>
                                        @(review.Reviewee?.FullName ?? "N/A")
                                    </td>

                                    <td>
                                        <span class="text-warning">
                                            @review.Rating / 5 ★
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(review.Comment)
                                            ? "No comment"
                                            : review.Comment)
                                    </td>

                                    <td>
                                        @review.CreatedAt.ToString("dd MMM yyyy")
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>

    <!-- ADMINISTRATION -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h5 class="fw-semibold mb-3">
                Administration
            </h5>

            <div class="d-flex flex-wrap gap-2">

                <a asp-action="Users"
                   class="btn btn-outline-primary">
                    Manage Users
                </a>

                <a asp-action="Devices"
                   class="btn btn-outline-primary">
                    Manage Devices
                </a>

                <a asp-action="RepairShops"
                   class="btn btn-outline-primary">
                    Manage Repair Shops
                </a>

                <a asp-action="Offers"
                   class="btn btn-outline-primary">
                    Manage Offers
                </a>

                <a asp-action="Reviews"
                   class="btn btn-outline-primary">
                    Manage Reviews
                </a>

            </div>

        </div>
    </div>

</div>