@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject SmartDeviceMatch.Data.ApplicationDbContext DbContext

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string displayName = User.Identity?.Name ?? "User";
    string initials = "U";
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var identityId = UserManager.GetUserId(User);
        if (!string.IsNullOrEmpty(identityId))
        {
            var appUser = DbContext.AppUsers.FirstOrDefault(u => u.IdentityUserId == identityId);
            if (appUser != null && !string.IsNullOrWhiteSpace(appUser.FullName))
            {
                displayName = appUser.FullName;
                var parts = appUser.FullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length >= 2)
                {
                    initials = $"{parts[0][0]}{parts[^1][0]}".ToUpper();
                }
                else if (parts.Length == 1 && parts[0].Length > 0)
                {
                    initials = parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                }
            }
            else if (!string.IsNullOrEmpty(User.Identity.Name))
            {
                initials = User.Identity.Name.Substring(0, Math.Min(2, User.Identity.Name.Length)).ToUpper();
            }
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartDeviceMatch</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartDeviceMatch.styles.css" asp-append-version="true" />

    <style>
        :root {
            --sdm-bg: #F8F6F2;
            --sdm-surface: #FFFFFF;
            --sdm-border: #EAE6DF;
            --sdm-border-subtle: #F2EFE9;
            --sdm-text-primary: #1E242B;
            --sdm-text-secondary: #6B7280;
            --sdm-text-muted: #8C847A;
            --sdm-primary: #BA3C2A;
            --sdm-primary-hover: #A13323;
            --sdm-primary-light: #FDF2F0;
            --sdm-primary-border: #FCE1DC;
            --sdm-primary-focus: rgba(186, 60, 42, 0.2);
            --sdm-radius-sm: 8px;
            --sdm-radius-md: 12px;
            --sdm-radius-lg: 16px;
            --sdm-radius-xl: 20px;
            --sdm-radius-pill: 9999px;
            --sdm-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04);
            --sdm-shadow-md: 0 4px 16px rgba(0, 0, 0, 0.04);
            --sdm-shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.06);
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--sdm-bg);
            color: var(--sdm-text-primary);
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* Topbar */
        .sdm-topbar {
            height: 72px;
            background: #FFFFFF;
            border-bottom: 1px solid var(--sdm-border);
            position: sticky;
            top: 0;
            z-index: 1020;
            display: flex;
            align-items: center;
            padding: 0 24px;
        }

        .sdm-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: inherit;
        }

        .sdm-logo-icon {
            width: 38px;
            height: 38px;
            border: 2px solid var(--sdm-primary);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--sdm-primary);
            font-size: 20px;
        }

        .sdm-brand-text {
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: #1E242B;
        }

        .sdm-brand-text span {
            color: var(--sdm-primary);
        }

        .sdm-search-form {
            max-width: 440px;
            width: 100%;
        }

        .sdm-search-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .sdm-search-input-wrap i {
            position: absolute;
            left: 14px;
            color: var(--sdm-text-muted);
            font-size: 15px;
            pointer-events: none;
        }

        .sdm-search-input {
            width: 100%;
            height: 42px;
            padding-left: 40px;
            padding-right: 16px;
            background-color: #F4F0E8;
            border: 1px solid transparent;
            border-radius: var(--sdm-radius-pill);
            font-size: 0.9rem;
            color: var(--sdm-text-primary);
            transition: all 0.2s ease;
        }

        .sdm-search-input:focus {
            background-color: #FFFFFF;
            border-color: var(--sdm-primary);
            box-shadow: 0 0 0 3px var(--sdm-primary-focus);
            outline: none;
        }

        .sdm-search-input::placeholder {
            color: var(--sdm-text-muted);
        }

        /* Topbar Actions */
        .sdm-icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid transparent;
            background: transparent;
            color: #4B5563;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            text-decoration: none;
            transition: all 0.15s ease;
            position: relative;
        }

        .sdm-icon-btn:hover {
            background: #F4F0E8;
            color: var(--sdm-primary);
        }

        .sdm-badge-count {
            position: absolute;
            top: 2px;
            right: 2px;
            background-color: var(--sdm-primary);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

        .sdm-user-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 12px 4px 4px;
            background: transparent;
            border: 1px solid transparent;
            border-radius: var(--sdm-radius-pill);
            cursor: pointer;
            text-decoration: none;
            color: var(--sdm-text-primary);
            transition: all 0.15s ease;
        }

        .sdm-user-pill:hover, .sdm-user-pill[aria-expanded="true"] {
            background: #F4F0E8;
        }

        .sdm-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #9B3224;
            color: #FFFFFF;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            letter-spacing: 0.5px;
        }

        .sdm-user-name {
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* Layout Grid */
        .sdm-layout-container {
            display: flex;
            min-height: calc(100vh - 72px);
        }

        /* Sidebar */
        .sdm-sidebar {
            width: 250px;
            background: transparent;
            padding: 24px 16px;
            flex-shrink: 0;
            border-right: 1px solid transparent;
        }

        .sdm-nav-group {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .sdm-nav-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 16px;
            border-radius: var(--sdm-radius-md);
            font-size: 0.95rem;
            font-weight: 500;
            color: #4B5563;
            text-decoration: none;
            transition: all 0.15s ease;
        }

        .sdm-nav-link i {
            font-size: 18px;
            width: 20px;
            text-align: center;
            color: #6B7280;
            transition: color 0.15s ease;
        }

        .sdm-nav-link:hover {
            background-color: rgba(186, 60, 42, 0.08);
            color: var(--sdm-primary);
        }

        .sdm-nav-link:hover i {
            color: var(--sdm-primary);
        }

        .sdm-nav-link.active {
            background-color: var(--sdm-primary);
            color: #FFFFFF;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(186, 60, 42, 0.25);
        }

        .sdm-nav-link.active i {
            color: #FFFFFF;
        }

        .sdm-nav-divider {
            height: 1px;
            background-color: var(--sdm-border);
            margin: 14px 12px;
        }

        .sdm-nav-section-title {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--sdm-text-muted);
            padding: 8px 16px 4px 16px;
        }

        /* Main Content */
        .sdm-content-wrap {
            flex-grow: 1;
            padding: 28px 36px 48px 36px;
            min-width: 0;
        }

        /* Universal Card & Component Styles */
        .sdm-card {
            background: var(--sdm-surface);
            border: 1px solid var(--sdm-border);
            border-radius: var(--sdm-radius-xl);
            box-shadow: var(--sdm-shadow-md);
            padding: 24px;
            transition: all 0.2s ease;
        }

        .sdm-card-hover:hover {
            transform: translateY(-2px);
            box-shadow: var(--sdm-shadow-lg);
            border-color: #E2DDD5;
        }

        .btn-terracotta {
            background-color: var(--sdm-primary);
            border-color: var(--sdm-primary);
            color: #FFFFFF;
            border-radius: var(--sdm-radius-pill);
            font-weight: 600;
            padding: 10px 22px;
            transition: all 0.15s ease;
        }

        .btn-terracotta:hover, .btn-terracotta:focus {
            background-color: var(--sdm-primary-hover);
            border-color: var(--sdm-primary-hover);
            color: #FFFFFF;
            box-shadow: 0 4px 12px rgba(186, 60, 42, 0.25);
        }

        .btn-terracotta-outline {
            background-color: transparent;
            border: 1.5px solid var(--sdm-primary);
            color: var(--sdm-primary);
            border-radius: var(--sdm-radius-pill);
            font-weight: 600;
            padding: 9px 20px;
            transition: all 0.15s ease;
        }

        .btn-terracotta-outline:hover {
            background-color: var(--sdm-primary-light);
            border-color: var(--sdm-primary);
            color: var(--sdm-primary);
        }

        /* Form elements */
        .form-control, .form-select {
            border-radius: var(--sdm-radius-md);
            border: 1px solid var(--sdm-border);
            padding: 10px 14px;
            font-size: 0.95rem;
            color: var(--sdm-text-primary);
            background-color: #FFFFFF;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--sdm-primary);
            box-shadow: 0 0 0 3px var(--sdm-primary-focus);
            outline: none;
        }

        /* Footer */
        .sdm-footer {
            margin-top: 48px;
            padding-top: 20px;
            border-top: 1px solid var(--sdm-border);
            font-size: 0.85rem;
            color: var(--sdm-text-muted);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .sdm-footer a {
            color: var(--sdm-text-secondary);
            text-decoration: none;
        }

        .sdm-footer a:hover {
            color: var(--sdm-primary);
        }

        @@media (max-width: 991.98px) {
            .sdm-sidebar {
                position: fixed;
                top: 72px;
                left: -260px;
                bottom: 0;
                width: 250px;
                background: #FFFFFF;
                z-index: 1010;
                box-shadow: 4px 0 20px rgba(0,0,0,0.1);
                transition: left 0.25s ease;
                overflow-y: auto;
            }

            .sdm-sidebar.show {
                left: 0;
            }

            .sdm-content-wrap {
                padding: 20px 16px;
            }

            .sdm-search-form {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- Top Navigation Bar -->
    <header class="sdm-topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-sm d-lg-none p-1 text-dark" type="button" id="sidebarToggle" aria-label="Toggle navigation">
                <i class="bi bi-list fs-3"></i>
            </button>
            <a class="sdm-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <div class="sdm-logo-icon">
                    <i class="bi bi-phone"></i>
                </div>
                <div class="sdm-brand-text">
                    SmartDevice<span>Match</span>
                </div>
            </a>
        </div>

        <!-- Global Search -->
        <div class="ms-4 me-auto d-none d-md-block sdm-search-form">
            <form asp-controller="Marketplace" asp-action="BrokenDevices" method="get">
                <div class="sdm-search-input-wrap">
                    <i class="bi bi-search"></i>
                    <input type="text" name="searchTerm" class="sdm-search-input" placeholder="Search devices, brands, or categories..." />
                </div>
            </form>
        </div>

        <!-- Right Side Icons & Profile -->
        <div class="ms-auto d-flex align-items-center gap-2">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- Notifications Dropdown -->
                <div class="dropdown">
                    <button class="sdm-icon-btn" type="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                        <i class="bi bi-bell"></i>
                        <span id="notificationBadge" class="sdm-badge-count d-none">0</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0" aria-labelledby="notificationDropdown" style="width: 360px; max-height: 460px; overflow-y: auto; border-radius: 16px;">
                        <div class="d-flex justify-content-between align-items-center px-3 py-3 border-bottom">
                            <strong class="text-dark">Notifications</strong>
                            <a asp-controller="Notification" asp-action="Index" class="small text-decoration-none fw-semibold" style="color: var(--sdm-primary);">
                                View All
                            </a>
                        </div>
                        <div id="notificationList">
                            <div class="text-center text-muted p-4 small">
                                Loading notifications...
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Messages -->
                <a asp-controller="Chat" asp-action="Index" class="sdm-icon-btn" title="Messages">
                    <i class="bi bi-chat-dots"></i>
                </a>

                <!-- User Profile Dropdown -->
                <div class="dropdown ms-2">
                    <div class="sdm-user-pill" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="sdm-avatar">
                            @initials
                        </div>
                        <span class="sdm-user-name d-none d-sm-inline">@displayName</span>
                        <i class="bi bi-chevron-down text-muted small ms-1"></i>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2" style="border-radius: 14px; min-width: 200px;">
                        <li class="px-3 py-2 border-bottom mb-1">
                            <div class="fw-bold text-dark text-truncate">@displayName</div>
                            <small class="text-muted text-truncate d-block">@User.Identity.Name</small>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person me-2 text-muted"></i> My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Manage/Index">
                                <i class="bi bi-gear me-2 text-muted"></i> Account Settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form class="px-2" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="btn btn-sm btn-terracotta-outline px-3" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
                <a class="btn btn-sm btn-terracotta px-3 ms-1" asp-area="Identity" asp-page="/Account/Register">Get Started</a>
            }
        </div>
    </header>

    <!-- App Shell Container -->
    <div class="sdm-layout-container">
        <!-- Sidebar Navigation -->
        <aside class="sdm-sidebar" id="sdmSidebar">
            <ul class="sdm-nav-group">
                <!-- Home -->
                <li>
                    <a class="sdm-nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door@(currentController == "Home" && currentAction == "Index" ? "-fill" : "")"></i>
                        <span>Home</span>
                    </a>
                </li>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <!-- Device Owner Links -->
                    @if (User.IsInRole("DeviceOwner"))
                    {
                        <li>
                            <a class="sdm-nav-link @(currentController == "Device" && currentAction == "Create" ? "active" : "")"
                               asp-controller="Device" asp-action="Create">
                                <i class="bi bi-plus-circle"></i>
                                <span>List a Device</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Marketplace" && currentAction == "BrokenDevices" ? "active" : "")"
                               asp-controller="Marketplace" asp-action="BrokenDevices">
                                <i class="bi bi-search"></i>
                                <span>Browse Devices</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Device" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Device" asp-action="Index">
                                <i class="bi bi-phone"></i>
                                <span>My Devices</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Offer" && currentAction == "Received" ? "active" : "")"
                               asp-controller="Offer" asp-action="Received">
                                <i class="bi bi-tag"></i>
                                <span>My Offers</span>
                            </a>
                        </li>
                    }

                    <!-- Repair Shop Links -->
                    @if (User.IsInRole("RepairShop"))
                    {
                        <li>
                            <a class="sdm-nav-link @(currentController == "Marketplace" && currentAction == "BrokenDevices" ? "active" : "")"
                               asp-controller="Marketplace" asp-action="BrokenDevices">
                                <i class="bi bi-search"></i>
                                <span>Browse Devices</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Offer" && currentAction == "MyOffers" ? "active" : "")"
                               asp-controller="Offer" asp-action="MyOffers">
                                <i class="bi bi-tag"></i>
                                <span>My Active Offers</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Offer" && currentAction == "MyRepairs" ? "active" : "")"
                               asp-controller="Offer" asp-action="MyRepairs">
                                <i class="bi bi-wrench-adjustable"></i>
                                <span>My Repairs</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Offer" && currentAction == "PurchaseReceived" ? "active" : "")"
                               asp-controller="Offer" asp-action="PurchaseReceived">
                                <i class="bi bi-box-arrow-in-down"></i>
                                <span>Received Purchase Offers</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Offer" && currentAction == "MySellerTransactions" ? "active" : "")"
                               asp-controller="Offer" asp-action="MySellerTransactions">
                                <i class="bi bi-cash-stack"></i>
                                <span>My Transactions</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "RepairShop" && currentAction == "Index" ? "active" : "")"
                               asp-controller="RepairShop" asp-action="Index">
                                <i class="bi bi-shop"></i>
                                <span>Shop Profile</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "RepairShop" && currentAction == "Specializations" ? "active" : "")"
                               asp-controller="RepairShop" asp-action="Specializations">
                                <i class="bi bi-award"></i>
                                <span>Specializations</span>
                            </a>
                        </li>
                    }

                    <!-- Buyer Links -->
                    @if (User.IsInRole("Buyer"))
                    {
                        <li>
                            <a class="sdm-nav-link @(currentController == "Marketplace" && currentAction == "Refurbished" ? "active" : "")"
                               asp-controller="Marketplace" asp-action="Refurbished">
                                <i class="bi bi-bag-check"></i>
                                <span>Browse Refurbished</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Offer" && currentAction == "MyPurchaseOffers" ? "active" : "")"
                               asp-controller="Offer" asp-action="MyPurchaseOffers">
                                <i class="bi bi-tag"></i>
                                <span>My Purchase Offers</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Offer" && currentAction == "MyBuyerTransactions" ? "active" : "")"
                               asp-controller="Offer" asp-action="MyBuyerTransactions">
                                <i class="bi bi-receipt"></i>
                                <span>My Transactions</span>
                            </a>
                        </li>
                    }

                    <!-- Common Authenticated Links -->
                    <li>
                        <a class="sdm-nav-link @(currentController == "Chat" ? "active" : "")"
                           asp-controller="Chat" asp-action="Index">
                            <i class="bi bi-chat-square-text"></i>
                            <span>Messages</span>
                        </a>
                    </li>
                    <li>
                        <a class="sdm-nav-link @(currentController == "Notification" ? "active" : "")"
                           asp-controller="Notification" asp-action="Index">
                            <i class="bi bi-bell"></i>
                            <span>Notifications</span>
                        </a>
                    </li>
                    <li>
                        <a class="sdm-nav-link @(currentController == "Profile" ? "active" : "")"
                           asp-controller="Profile" asp-action="Index">
                            <i class="bi bi-person"></i>
                            <span>My Profile</span>
                        </a>
                    </li>

                    <!-- Admin Links -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="sdm-nav-divider"></li>
                        <li class="sdm-nav-section-title">Administration</li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-check"></i>
                                <span>Admin Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a class="sdm-nav-link @(currentController == "Admin" && currentAction == "Disputes" ? "active" : "")"
                               asp-controller="Admin" asp-action="Disputes">
                                <i class="bi bi-exclamation-triangle"></i>
                                <span>Disputes</span>
                            </a>
                        </li>
                    }
                }
                else
                {
                    <li>
                        <a class="sdm-nav-link @(currentController == "Marketplace" && currentAction == "BrokenDevices" ? "active" : "")"
                           asp-controller="Marketplace" asp-action="BrokenDevices">
                            <i class="bi bi-search"></i>
                            <span>Browse Devices</span>
                        </a>
                    </li>
                    <li>
                        <a class="sdm-nav-link @(currentController == "Marketplace" && currentAction == "Refurbished" ? "active" : "")"
                           asp-controller="Marketplace" asp-action="Refurbished">
                            <i class="bi bi-bag-check"></i>
                            <span>Refurbished Marketplace</span>
                        </a>
                    </li>
                }

                <li class="sdm-nav-divider"></li>
                <li>
                    <a class="sdm-nav-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")"
                       asp-controller="Home" asp-action="Privacy">
                        <i class="bi bi-shield-lock"></i>
                        <span>Privacy</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Main Workspace -->
        <main class="sdm-content-wrap" role="main">
            @RenderBody()

            <!-- Minimal Footer -->
            <footer class="sdm-footer">
                <div>
                    &copy; 2026 SmartDeviceMatch &bull; Sustainable Device Lifecycle Platform
                </div>
                <div>
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                </div>
            </footer>
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }

    <script>
        // Responsive sidebar toggle for mobile
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sdmSidebar = document.getElementById('sdmSidebar');
        if (sidebarToggle && sdmSidebar) {
            sidebarToggle.addEventListener('click', () => {
                sdmSidebar.classList.toggle('show');
            });
            document.addEventListener('click', (e) => {
                if (window.innerWidth < 992 && !sdmSidebar.contains(e.target) && !sidebarToggle.contains(e.target)) {
                    sdmSidebar.classList.remove('show');
                }
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>