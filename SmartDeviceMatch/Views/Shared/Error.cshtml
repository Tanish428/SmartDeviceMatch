@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">

        <div class="card sdm-card border-0 shadow-sm overflow-hidden text-center p-4 p-md-5">

            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width: 72px; height: 72px; background: rgba(186, 60, 42, 0.1); color: var(--sdm-primary); font-size: 32px;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <h2 class="fw-bold text-dark mb-2">Something went wrong</h2>
            <p class="text-muted small mb-4">
                An unexpected error occurred while processing your request. Please try again or return to the dashboard.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="p-3 rounded-3 mb-4 text-start font-monospace small" style="background: #F9F8F5; border: 1px solid #ECE7DE;">
                    <span class="text-muted d-block small">Request Identifier:</span>
                    <strong class="text-dark">@Model.RequestId</strong>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-terracotta rounded-pill px-4">
                    <i class="bi bi-house-door me-1"></i> Return Home
                </a>
            </div>

            @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
            {
                <div class="mt-5 pt-4 border-top text-start">
                    <h6 class="fw-bold text-danger mb-2">
                        <i class="bi bi-bug me-1"></i> Development Diagnostics
                    </h6>
                    <p class="text-muted small mb-0">
                        Swapping to <strong>Development</strong> environment displays detailed exception information.
                        Ensure this is disabled in production environments.
                    </p>
                </div>
            }

        </div>

    </div>
</div>
