@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">

            <!-- Hero Header -->
            <div class="text-center mb-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width: 64px; height: 64px; background: rgba(186, 60, 42, 0.1); color: var(--sdm-primary); font-size: 28px;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h1 class="fw-bold text-dark mb-2">Privacy Policy</h1>
                <p class="text-muted small mb-0">Last updated: October 2026 &bull; SmartDeviceMatch Security & Trust</p>
            </div>

            <!-- Content Card -->
            <div class="card sdm-card border-0 shadow-sm p-4 p-md-5">

                <section class="mb-5">
                    <h4 class="fw-bold text-dark mb-3">
                        <i class="bi bi-person-check text-muted me-2"></i>1. Information We Collect
                    </h4>
                    <p class="text-secondary leading-relaxed">
                        At SmartDeviceMatch, we collect information necessary to connect buyers, sellers, and certified repair technicians safely and efficiently:
                    </p>
                    <ul class="text-secondary ps-3">
                        <li class="mb-2"><strong>Account Information:</strong> Name, email address, phone number, location (city/state), and user role.</li>
                        <li class="mb-2"><strong>Device Data:</strong> Brand, model, physical condition, diagnostic details, repair history, and photos uploaded for inspection or listing.</li>
                        <li class="mb-2"><strong>Transaction Records:</strong> Repair quotes, purchase bids, escrow statuses, and service completion logs.</li>
                    </ul>
                </section>

                <hr class="my-4 opacity-10" />

                <section class="mb-5">
                    <h4 class="fw-bold text-dark mb-3">
                        <i class="bi bi-shield-shaded text-muted me-2"></i>2. Escrow & Payment Protection
                    </h4>
                    <p class="text-secondary leading-relaxed">
                        Transactions executed via SmartDeviceMatch utilize a structured escrow framework to protect buyers and service partners:
                    </p>
                    <div class="p-3 rounded-3 mb-3" style="background: #F9F8F5; border: 1px solid #ECE7DE;">
                        <div class="d-flex align-items-center gap-2 mb-1 text-dark fw-bold">
                            <i class="bi bi-lock-fill" style="color: var(--sdm-primary);"></i> Secure Funds Holding
                        </div>
                        <p class="text-muted small mb-0">
                            Payments for devices and repair services remain safely locked until both parties verify condition, repair completion, or dispatch tracking.
                        </p>
                    </div>
                </section>

                <hr class="my-4 opacity-10" />

                <section class="mb-5">
                    <h4 class="fw-bold text-dark mb-3">
                        <i class="bi bi-chat-dots text-muted me-2"></i>3. Communication & Messaging
                    </h4>
                    <p class="text-secondary leading-relaxed">
                        Direct messaging between buyers and repair shops is monitored by automated system safeguards to prevent fraudulent off-platform transactions and safeguard user privacy.
                    </p>
                </section>

                <hr class="my-4 opacity-10" />

                <section>
                    <h4 class="fw-bold text-dark mb-3">
                        <i class="bi bi-envelope-paper text-muted me-2"></i>4. Contact Our Privacy Team
                    </h4>
                    <p class="text-secondary mb-3">
                        If you have questions regarding your personal information, data rights, or platform security, please reach out to our team:
                    </p>
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-light border text-dark fw-semibold small">
                        <i class="bi bi-envelope text-muted"></i> privacy@smartdevicematch.com
                    </div>
                </section>

            </div>

        </div>
    </div>
</div>
