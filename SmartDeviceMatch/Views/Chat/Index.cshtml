@model IEnumerable<SmartDeviceMatch.ViewModels.ChatConversationViewModel>

@{
    ViewData["Title"] = "My Chats";
}

<div class="d-flex flex-column gap-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Messages</h2>
            <p class="text-muted mb-0">
                Direct conversations with buyers, device owners, and repair shops.
            </p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 20px; border: 1px dashed var(--sdm-border) !important;">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width: 72px; height: 72px; background: #EFF6FF; color: #2563EB; font-size: 30px;">
                <i class="bi bi-chat-square-dots"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No conversations yet</h4>
            <p class="text-muted mx-auto mb-0" style="max-width: 420px;">
                When you or another user send an inquiry on a device offer, your chats will appear here.
            </p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var chat in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm sdm-card-hover p-4 d-flex flex-column justify-content-between"
                         style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                         style="width: 42px; height: 42px; background: #9B3224; font-size: 15px;">
                                        @(string.IsNullOrEmpty(chat.OtherUserName) ? "U" : chat.OtherUserName[0].ToString().ToUpper())
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 160px;">
                                            @chat.OtherUserName
                                        </h6>
                                        <span class="badge rounded-pill bg-light text-secondary border small">
                                            @chat.DeviceName
                                        </span>
                                    </div>
                                </div>

                                @if (chat.UnreadCount > 0)
                                {
                                    <span class="badge rounded-pill bg-danger">
                                        @chat.UnreadCount new
                                    </span>
                                }
                            </div>

                            <div class="my-3 p-3 rounded-3" style="background: #F9F8F5; border: 1px solid #ECE7DE;">
                                <p class="small text-secondary mb-1" style="min-height: 40px;">
                                    @(string.IsNullOrWhiteSpace(chat.LastMessage) ? "No messages yet." :
                                      (chat.LastMessage.Length > 85 ? chat.LastMessage[..85] + "..." : chat.LastMessage))
                                </p>
                                <small class="text-muted d-block text-end" style="font-size: 11px;">
                                    @(chat.LastMessageAt?.ToLocalTime().ToString("dd MMM, hh:mm tt") ?? "")
                                </small>
                            </div>
                        </div>

                        <a asp-action="Conversation"
                           asp-route-deviceId="@chat.DeviceId"
                           asp-route-otherUserId="@chat.OtherUserId"
                           class="btn btn-terracotta rounded-pill w-100 btn-sm">
                            <i class="bi bi-chat-text me-1"></i> Open Chat
                        </a>

                    </div>
                </div>
            }
        </div>
    }

</div>