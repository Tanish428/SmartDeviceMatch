@model SmartDeviceMatch.ViewModels.ChatViewModel

@{
    ViewData["Title"] = $"Chat with {Model.OtherUserName}";
}

<div class="d-flex flex-column gap-3">

    <!-- Chat Header Navigation -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1">
            <i class="bi bi-arrow-left me-1"></i> Back to Chats
        </a>

        <div class="badge rounded-pill px-3 py-1 bg-light text-secondary border">
            <i class="bi bi-phone me-1"></i> Device: <strong>@Model.DeviceName</strong>
        </div>
    </div>

    <!-- Elevated Chat Container -->
    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; border: 1px solid var(--sdm-border) !important;">

        <!-- Active Conversation Header -->
        <div class="card-header bg-white border-bottom p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                         style="width: 44px; height: 44px; background: #9B3224; font-size: 16px;">
                        @(string.IsNullOrEmpty(Model.OtherUserName) ? "U" : Model.OtherUserName[0].ToString().ToUpper())
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">@Model.OtherUserName</h6>
                        <div id="typingIndicator" class="small text-muted" style="display:none;">
                            <i class="bi bi-three-dots"></i> typing...
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span id="connectionStatus" class="small fw-semibold text-success d-flex align-items-center gap-1">
                        <span class="rounded-circle bg-success d-inline-block" style="width: 8px; height: 8px;"></span> Connected
                    </span>
                </div>
            </div>
        </div>

        <!-- Scrollable Chat Stream -->
        <div id="chatMessages" class="card-body p-4" style="height: 480px; overflow-y: auto; background-color: #FBF9F6;">

            @if (!Model.Messages.Any())
            {
                <div id="emptyChat" class="text-center text-muted my-auto py-5">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                         style="width: 60px; height: 60px; background: #ECE6DE; color: #8C847A; font-size: 26px;">
                        <i class="bi bi-chat-quote"></i>
                    </div>
                    <h6 class="fw-bold text-dark">No messages yet</h6>
                    <p class="small text-muted mb-0">Ask questions regarding repair costs, scheduling, or pickup details below.</p>
                </div>
            }

            @foreach (var message in Model.Messages)
            {
                <div class="d-flex mb-3 @(message.IsMine ? "justify-content-end" : "justify-content-start")" data-message-id="@message.Id">
                    <div class="chat-bubble @(message.IsMine ? "chat-mine" : "chat-other") shadow-sm">
                        <div class="chat-content">
                            @message.Content
                        </div>
                        <div class="chat-meta">
                            @message.SentAt.ToLocalTime().ToString("hh:mm tt")
                            @if (message.IsMine)
                            {
                                <span class="message-read-status ms-1">
                                    @(message.IsRead ? "✓✓ Read" : "✓ Sent")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- Chat Input Footer -->
        <div class="card-footer bg-white border-top p-3">
            <form id="chatForm">
                <div class="input-group">
                    <textarea id="messageInput"
                              class="form-control border-end-0"
                              rows="2"
                              maxlength="1000"
                              placeholder="Type your message here..."
                              style="border-radius: 14px 0 0 14px; resize: none; background: #F8F6F2;"
                              autocomplete="off"></textarea>

                    <button type="submit" class="btn btn-terracotta px-4" style="border-radius: 0 14px 14px 0;">
                        <i class="bi bi-send-fill me-1"></i> Send
                    </button>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-2 px-1">
                    <small class="text-muted" style="font-size: 11px;">
                        Max 1,000 characters &bull; Press Enter or click Send
                    </small>
                </div>
            </form>
        </div>

    </div>

</div>

<style>
    .chat-bubble {
        max-width: 70%;
        padding: 12px 16px;
        border-radius: 18px;
    }

    .chat-mine {
        background-color: var(--sdm-primary);
        color: #FFFFFF;
        border-bottom-right-radius: 4px;
    }

    .chat-other {
        background-color: #FFFFFF;
        color: var(--sdm-text-primary);
        border: 1px solid var(--sdm-border);
        border-bottom-left-radius: 4px;
    }

    .chat-content {
        white-space: pre-wrap;
        word-break: break-word;
        font-size: 0.95rem;
        line-height: 1.4;
    }

    .chat-meta {
        font-size: 11px;
        margin-top: 5px;
        opacity: 0.8;
        text-align: right;
    }

    .chat-mine .chat-meta {
        color: rgba(255, 255, 255, 0.85);
    }
</style>

@section Scripts
{
    <script>
        window.chatConfig = {
            deviceId: @Model.DeviceId,
            currentUserId: @Model.CurrentUserId,
            otherUserId: @Model.OtherUserId
        };
    </script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}